<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SimpleSign.Desktop.ViewModels"
             xmlns:s="using:SimpleSign.Desktop.Services"
             xmlns:c="using:SimpleSign.Desktop.Controls"
             xmlns:v="using:SimpleSign.Desktop.Views"
             x:Class="SimpleSign.Desktop.Views.IcpBrasilView"
             x:DataType="vm:IcpBrasilViewModel">
  <StackPanel Spacing="16">
    <c:PageChrome />
    <Border Classes="card">
      <StackPanel Spacing="12">
        <DockPanel>
          <Button DockPanel.Dock="Right" Classes="accent" Content="Atualizar LPAs do ITI" Command="{Binding RefreshLpasCommand}" />
          <StackPanel Spacing="2">
            <TextBlock Classes="title" Text="Listas de políticas (LPA)" />
            <TextBlock Classes="caption" TextWrapping="Wrap" Text="Baixa LPA_PAdES, LPA_CAdES e LPA_XAdES, confere a assinatura do ITI e aplica novas versões e revogações." />
          </StackPanel>
        </DockPanel>
        <TextBlock Classes="caption" Text="{Binding LpaStatus}" TextWrapping="Wrap" IsVisible="{Binding LpaStatus, Converter={x:Static v:Converters.NotNull}}" />
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Spacing="12">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
            <ToggleSwitch IsChecked="{Binding OnlyInForce}" />
            <TextBlock Text="Só vigentes" VerticalAlignment="Center" />
          </StackPanel>
          <ListBox Classes="segmented" ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}" HorizontalAlignment="Left">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:OptionBase"><TextBlock Text="{Binding Label}" /></DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
        <Grid ColumnDefinitions="2*,60,1.6*,1.2*,90" Margin="12,4">
          <TextBlock Classes="caption" Text="POLÍTICA" />
          <TextBlock Grid.Column="1" Classes="caption" Text="VERSÃO" />
          <TextBlock Grid.Column="2" Classes="caption" Text="PERÍODO" />
          <TextBlock Grid.Column="3" Classes="caption" Text="RAÍZES ACEITAS" />
          <TextBlock Grid.Column="4" Classes="caption" Text="ESTADO" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Policies}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PolicyRow">
              <Border Classes="group" Margin="0,3" Padding="12,8">
                <Grid ColumnDefinitions="2*,60,1.6*,1.2*,90">
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Classes="caption mono" Text="{Binding Oid}" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding Version}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding Period}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="{Binding Roots}" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <Border Grid.Column="4" Classes="badge" Classes.ok="{Binding InForce}" Classes.error="{Binding Revoked}" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <TextBlock Text="{Binding State}" />
                  </Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
    <Grid ColumnDefinitions="*,16,*">
      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="title" Text="AC Raiz embarcadas" />
          <ItemsControl ItemsSource="{Binding Roots}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RootRow">
                <DockPanel Margin="0,3">
                  <TextBlock DockPanel.Dock="Right" Classes="caption" Text="{Binding Expires, StringFormat='até {0}'}" />
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Classes="card" VerticalAlignment="Top">
        <StackPanel Spacing="10">
          <DockPanel>
            <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding Homologation}" />
            <TextBlock Classes="title" Text="Cadeia de homologação" VerticalAlignment="Center" />
          </DockPanel>
          <TextBlock Classes="subtitle" Text="Aceita certificados de teste do SERPRO e das ACs (AC Raiz v12 - HOM). Assinaturas com eles aparecem como homologação e nunca como qualificadas. Não use em produção." />
        </StackPanel>
      </Border>
    </Grid>
  </StackPanel>
</UserControl>
