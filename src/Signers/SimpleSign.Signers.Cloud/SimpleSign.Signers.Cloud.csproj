<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>SimpleSign.Signers.Cloud</AssemblyName>
    <RootNamespace>SimpleSign.Signers.Cloud</RootNamespace>
    <PackageId>SimpleSign.Signers.Cloud</PackageId>
    <Description>Sign PAdES, CAdES and XAdES documents with cloud certificates: ICP-Brasil PSCs (BirdID, VIDaaS, NeoID, SafeID, RemoteID — ITI API v0, DOC-ICP-17.01) and Cloud Signature Consortium API v2 providers. OAuth 2.0 with PKCE. No third-party dependencies. Native AOT compatible.</Description>
    <PackageTags>cloud-signature;remote-signing;psc;icp-brasil;birdid;vidaas;csc;cloud-signature-consortium;oauth2;pkce;digital-signature;external-signer;native-aot</PackageTags>
    <Version>0.11.0</Version>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net9.0'))">true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SimpleSign.Signers.Cloud.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\SimpleSign.Core\SimpleSign.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.403" PrivateAssets="all" />
  </ItemGroup>
</Project>
