<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>SimpleSign</AssemblyName>
    <RootNamespace>SimpleSign</RootNamespace>
    <PackageId>SimpleSign</PackageId>
    <Description>Meta-package for the SimpleSign signature formats: PAdES (PDF), CAdES and XAdES signing and validation, on SimpleSign.Core.</Description>
    <Version>0.10.1</Version>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net9.0'))">true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\SimpleSign.Core\SimpleSign.Core.csproj" />
    <ProjectReference Include="..\SimpleSign.CAdES\SimpleSign.CAdES.csproj" />
    <ProjectReference Include="..\SimpleSign.PAdES\SimpleSign.PAdES.csproj" />
    <ProjectReference Include="..\SimpleSign.XAdES\SimpleSign.XAdES.csproj" />
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.403" PrivateAssets="all" />
  </ItemGroup>
</Project>
