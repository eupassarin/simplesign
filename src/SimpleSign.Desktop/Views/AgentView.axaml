<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SimpleSign.Desktop.ViewModels"
             xmlns:s="using:SimpleSign.Desktop.Services"
             xmlns:c="using:SimpleSign.Desktop.Controls"
             xmlns:v="using:SimpleSign.Desktop.Views"
             x:Class="SimpleSign.Desktop.Views.AgentView"
             x:DataType="vm:AgentViewModel">
  <StackPanel Spacing="16">
    <c:PageChrome />
    <Border Classes="card">
      <StackPanel Spacing="14">
        <DockPanel>
          <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding IsEnabled}" />
          <StackPanel Spacing="2">
            <TextBlock Classes="title" Text="Agente de assinatura" />
            <TextBlock Classes="caption" Text="{Binding Status}" />
          </StackPanel>
        </DockPanel>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Text="Porta" VerticalAlignment="Center" />
          <NumericUpDown Value="{Binding Port}" Minimum="1024" Maximum="65535" Increment="1" FormatString="0" Width="130" />
          <Button Content="Aplicar" Command="{Binding ApplyCommand}" />
        </StackPanel>
        <TextBlock Classes="caption" TextWrapping="Wrap"
                   Text="Escuta somente em 127.0.0.1. Cada site precisa ser autorizado; cada assinatura é confirmada aqui e o PIN do token nunca passa pelo navegador. Fechar a janela mantém o agente na barra de menus." />
      </StackPanel>
    </Border>
    <Grid ColumnDefinitions="*,16,*">
      <Border Classes="card" VerticalAlignment="Top">
        <StackPanel Spacing="8">
          <TextBlock Classes="title" Text="Sites autorizados" />
          <TextBlock Classes="caption" Text="Nenhum site autorizado permanentemente." IsVisible="{Binding !AllowedOrigins.Count}" />
          <ItemsControl ItemsSource="{Binding AllowedOrigins}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <DockPanel Margin="0,3">
                  <Button DockPanel.Dock="Right" Classes="link" Content="Remover"
                          Command="{Binding $parent[ItemsControl].((vm:AgentViewModel)DataContext).ForgetCommand}" CommandParameter="{Binding}" />
                  <TextBlock Classes="mono" Text="{Binding}" VerticalAlignment="Center" />
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Classes="title" Text="Como integrar" />
          <SelectableTextBlock Classes="mono" FontSize="11" Text="{Binding Example}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>
    <Border Classes="card">
      <StackPanel Spacing="8">
        <TextBlock Classes="title" Text="Atividade" />
        <ItemsControl ItemsSource="{Binding Log}" MaxHeight="320">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="s:LogEntry">
              <Grid ColumnDefinitions="70,110,*" Margin="0,2">
                <TextBlock Classes="caption mono" Text="{Binding TimeText}" />
                <TextBlock Grid.Column="1" Classes="caption" Text="{Binding Source}" />
                <TextBlock Grid.Column="2" Text="{Binding Message}" TextWrapping="Wrap" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
