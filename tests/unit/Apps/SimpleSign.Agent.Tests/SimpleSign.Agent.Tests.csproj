<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <!-- xUnit1051 (pass TestContext.Current.CancellationToken) comes with xunit v3, which this project
         alone uses: Avalonia.Headless.XUnit 12 needs it; the other test projects are on xunit 2. -->
    <NoWarn>$(NoWarn);CA1829;CA1861;CA2007;CA1707;CA1515;CA2000;CA5394;CA1001;xUnit1051</NoWarn>
    <IsTestProject>true</IsTestProject>
    <!-- This project targets net10.0 only. A solution-wide `dotnet test` for one framework (the CI
         matrix runs one per framework) asks every test project for that framework's output; asked
         for net8.0, this one has none and the whole run fails with "the argument ... .dll is
         invalid". Not being a test project for that framework leaves it out of the run instead. -->
    <IsTestProject Condition="'$(TargetFramework)' != '' and '$(TargetFramework)' != 'net10.0'">false</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.2.0" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\Apps\SimpleSign.Agent\SimpleSign.Agent.csproj" />
    <ProjectReference Include="..\..\..\shared\SimpleSign.TestHelpers\SimpleSign.TestHelpers.csproj" />
  </ItemGroup>

</Project>
