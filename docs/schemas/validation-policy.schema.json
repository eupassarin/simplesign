{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/eupassarin/SimpleSign/main/docs/schemas/validation-policy.schema.json",
  "title": "SimpleSign validation policy",
  "description": "A validation policy in the structure of the EU DSS validation policy (policy.xsd, http://dss.esig.europa.eu/validation/policy), as JSON: one property per element, attributes as properties, the Id and Algo lists as arrays.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "ConstraintsParameters": {
      "$ref": "#/$defs/ConstraintsParameters"
    }
  },
  "required": [
    "ConstraintsParameters"
  ],
  "additionalProperties": false,
  "$defs": {
    "Level": {
      "type": "string",
      "enum": [
        "FAIL",
        "WARN",
        "INFORM",
        "IGNORE"
      ]
    },
    "TimeUnit": {
      "type": "string",
      "enum": [
        "DAYS",
        "HOURS",
        "MINUTES",
        "SECONDS",
        "MILLISECONDS"
      ]
    },
    "Model": {
      "type": "string",
      "enum": [
        "SHELL",
        "CHAIN",
        "HYBRID"
      ]
    },
    "Algo": {
      "description": "An algorithm name, or an object with its name (Value), the key size it is about (Size) and its expiration date (Date).",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "Value": {
              "type": "string"
            },
            "Size": {
              "type": "integer"
            },
            "Date": {
              "type": "string"
            }
          },
          "required": [
            "Value"
          ],
          "additionalProperties": false
        }
      ]
    },
    "AlgoExpirationDate": {
      "type": "object",
      "properties": {
        "Level": {
          "$ref": "#/$defs/Level"
        },
        "Format": {
          "type": "string"
        },
        "UpdateDate": {
          "type": "string"
        },
        "LevelAfterUpdate": {
          "$ref": "#/$defs/Level"
        },
        "Algo": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Algo"
          }
        }
      },
      "additionalProperties": false
    },
    "AttestationConstraints": {
      "type": "object",
      "properties": {
        "Level": {
          "$ref": "#/$defs/Level"
        },
        "AttestationSignatureUnicity": {
          "$ref": "#/$defs/LevelConstraint"
