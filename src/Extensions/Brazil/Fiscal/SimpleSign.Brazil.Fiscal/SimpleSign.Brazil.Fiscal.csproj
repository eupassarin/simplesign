<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>SimpleSign.Brazil.Fiscal</AssemblyName>
    <RootNamespace>SimpleSign.Brazil.Fiscal</RootNamespace>
    <PackageId>SimpleSign.Brazil.Fiscal</PackageId>
    <Description>XML-DSig signing and validation of Brazilian fiscal XML with ICP-Brasil certificates: NF-e, NFC-e, CT-e, MDF-e (and their events), NFS-e Nacional, eSocial and EFD-Reinf. In one call, in batches, or in two phases for A3 tokens and local agents.</Description>
    <PackageTags>nfe;nfce;cte;mdfe;nfse;esocial;reinf;xmldsig;icp-brasil;brazil;fiscal</PackageTags>
    <Version>0.17.0</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Core\SimpleSign.Core\SimpleSign.Core.csproj" />
    <ProjectReference Include="..\..\..\..\Formats\SimpleSign.XAdES\SimpleSign.XAdES.csproj" />
    <ProjectReference Include="..\..\SimpleSign.Brazil\SimpleSign.Brazil.csproj" />
    <ProjectReference Include="..\..\IcpBrasil\SimpleSign.Brazil.IcpBrasil\SimpleSign.Brazil.IcpBrasil.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.403" PrivateAssets="all" />
  </ItemGroup>
</Project>
