<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>SimpleSign.Brasil.Fiscal</AssemblyName>
    <RootNamespace>SimpleSign.Brasil.Fiscal</RootNamespace>
    <PackageId>SimpleSign.Brasil.Fiscal</PackageId>
    <Description>XMLDSig signing and validation of Brazilian fiscal XML: NF-e, NFC-e, CT-e, MDF-e (and their events), NFS-e Nacional, eSocial and EFD-Reinf, with ICP-Brasil certificates.</Description>
    <PackageTags>nfe;nfce;cte;mdfe;nfse;esocial;reinf;xmldsig;icp-brasil;brazil;fiscal</PackageTags>
    <Version>0.10.1</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\SimpleSign.Core\SimpleSign.Core.csproj" />
    <ProjectReference Include="..\SimpleSign.Brasil\SimpleSign.Brasil.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SimpleSign.Brasil.Fiscal.Tests" />
    <InternalsVisibleTo Include="SimpleSign.Cli" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.403" PrivateAssets="all" />
  </ItemGroup>
</Project>
