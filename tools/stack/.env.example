# Local settings for tools/stack (the Sandbox and DSS in Docker).
#   cp tools/stack/.env.example tools/stack/.env     then uncomment what you change.
# .env is not committed (.gitignore): it is this machine's choice. Every line left commented keeps the
# default written in the compose files. Changes apply when the containers are created again
# (tools/stack/up.sh, or docker compose -f tools/stack/docker-compose.yml up -d --build).
# What each DSS setting means for its verdicts: the Overview tab of the TestBench's DSS drawer.

# --- Ports (on 127.0.0.1) -----------------------------------------------------------------------
# The Sandbox's ports are also the ones its certificates name: change all three together to run it
# next to another Sandbox.
#SANDBOX_PORT=5300
#SANDBOX_HTTPS_PORT=5301
#SANDBOX_LDAP_PORT=5302
#DSS_PORT=8080

# --- How DSS trusts the Sandbox -----------------------------------------------------------------
# list: through its list of trusted lists, as DSS trusts the EU's (the same way SimpleSign trusts it).
# anchor: its root alone, as a bare trust anchor (no trusted-list checks).
#DSS_SANDBOX_TRUST=list

# --- Trusted lists ------------------------------------------------------------------------------
# The EU trusted lists, to validate real EU signatures:
#   false   none (default)
#   true    downloaded at start and every hour (internet; the first load takes minutes)
#   cached  only what an earlier "true" run kept: run once with true first, or the cache is empty.
#           With the Sandbox trusted through its list the loader stays online, so the EU lists are
#           still refreshed every hour.
#DSS_LOAD_EU_TRUSTED_LISTS=false
# Seconds between downloads of the lists. Empty: 10 with the Sandbox's list alone, 3600 with the EU's.
# A trusted-list failure switched on in the Sandbox shows in DSS only after the next download.
#DSS_TL_REFRESH_SECONDS=
# true keeps a list whose signature fails (the DSS demo's default); false refuses it (TS 119 615), as SimpleSign does.
#DSS_ACCEPT_INVALID_TRUSTED_LISTS=false

# --- Trust anchors ------------------------------------------------------------------------------
#DSS_TRUST_ICP_BRASIL=true
#DSS_TRUST_GOVBR=true
#DSS_TRUST_TSA_ROOTS=true
#DSS_TRUST_PERU=true
#DSS_PERU_TSL_URL=https://iofe.indecopi.gob.pe/TSL/tsl-pe.xml

# --- Revocation ---------------------------------------------------------------------------------
# false: CRLs and OCSP fetched on every request, like SimpleSign. true: the DSS demo's cache (up to
# 3 hours), which answers from old data when the Sandbox's servers are down.
#DSS_REVOCATION_CACHE=false

# The stack sets where DSS finds the Sandbox (SANDBOX_URL, SANDBOX_FORWARD_HOST, SANDBOX_FORWARD_PORTS)
# from the ports above: they are not set here.
