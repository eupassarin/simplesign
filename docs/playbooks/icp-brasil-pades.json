{
  "$schema": "https://raw.githubusercontent.com/eupassarin/SimpleSign/main/docs/schemas/playbook.schema.json",
  "schema": 2,
  "id": "icp-brasil-pades",
  "title": "ICP-Brasil PAdES (AD-RB, AD-RT, AD-RC, AD-RA)",
  "description": "PAdES signatures under the ICP-Brasil signature policies (DOC-ICP-15.03: AD-RB, AD-RT, AD-RC and AD-RA; AD-RV has no PAdES form) with the icp-brasil trust profile and its signing and validation policies, through the library and the CLI. The Sandbox stands in for ICP-Brasil: its trust is added to the profile's (trustProfiles: Sandbox), so its certificates and its TSA play the part of an AC and an ACT; the first section shows that the profile alone trusts only the AC Raiz roots. AD-RA downloads its policy artifacts (LPA_PAdES and the PA) from ITI's repository, so that step needs the network. Tags name the policy (AD-RB…), the ICP-Brasil document (DOC-ICP-15.03 policies, DOC-ICP-01.01 algorithms) and a topic.",
  "defaults": {
    "engine": "both",
    "format": "pades",
    "options": {
      "common": {
        "credentialId": "sandbox:rsa-2048",
        "kind": "IcpBrasil",
        "icpPolicy": "AdRb",
        "timestamp": { "provider": "Sandbox" },
        "signingPolicyId": "preset:signing:icp-brasil",
        "signingControls": { "profile": "IcpBrasil", "trustProfiles": ["Sandbox"] },
        "attemptRefused": true,
        "validation": { "trust": [], "profile": "IcpBrasil", "trustProfiles": ["Sandbox"], "policyId": "preset:validation:icp-brasil" }
      },
      "pades": { "documentId": "sample:contract" }
    }
  },
  "sections": [
    {
      "id": "profile",
      "title": "The ICP-Brasil profile",
      "description": "Its anchors are the AC Raiz roots bundled with SimpleSign.Brazil.IcpBrasil and its chain validation is ICP-Brasil's. A certificate that does not chain to them is refused before signing; the Sandbox's trust, added to the profile, lets the rest of the playbook sign with test certificates.",
      "steps": [
        { "id": "profile-roots-only", "title": "Profile alone: a certificate outside ICP-Brasil is refused", "tags": ["DOC-ICP-15.03", "trust"],
          "description": "Only the AC Raiz roots are anchors: the Sandbox's chain is not trusted, and the library refuses to sign (UntrustedRoot).",
          "options": { "signingControls": { "profile": "IcpBrasil", "trustProfiles": [] } },
          "expect": { "outcome": "refused", "reason": "UntrustedRoot" } },
        { "id": "profile-with-sandbox", "title": "Profile with the Sandbox's trust added: signed", "tags": ["DOC-ICP-15.03", "trust"],
          "description": "The ICP-Brasil policies stay the profile's; only the Sandbox's anchors are added.",
          "expect": { "outcome": "signed", "level": "B-B", "indication": "TOTAL_PASSED" } }
      ]
    },
    {
      "id": "policies",
      "title": "Signature policies (DOC-ICP-15.03)",
      "description": "Each policy writes its identifier and the hash of the policy document (signature-policy-identifier), the /Filter /PBAD_PAdES /SubFilter /PBAD.PAdES signature dictionary, and the level it needs. The newest version of the policy in force is chosen. Each signature is validated right after with the ICP-Brasil validation policy.",
      "steps": [
        { "id": "ad-rb", "title": "AD-RB (basic reference)", "tags": ["AD-RB", "DOC-ICP-15.03", "policy"],
          "expect": { "outcome": "signed", "level": "B-B", "indication": "TOTAL_PASSED" } },
        { "id": "ad-rt", "title": "AD-RT (time reference): signature time-stamp from the ACT", "tags": ["AD-RT", "DOC-ICP-15.03", "policy", "tsa"],
          "options": { "icpPolicy": "AdRt" },
          "expect": { "outcome": "signed", "level": "B-T", "indication": "TOTAL_PASSED" } },
        { "id": "ad-rc", "title": "AD-RC (complete references): validation data and a document time-stamp", "tags": ["AD-RC", "DOC-ICP-15.03", "policy", "ltv"],
          "options": { "icpPolicy": "AdRc" },
          "expect": { "outcome": "signed", "level": "B-LTA", "indication": "TOTAL_PASSED" } },
        { "id": "ad-ra", "title": "AD-RA (archival): AD-RC plus the PA, the LPA and its signature in the DSS", "tags": ["AD-RA", "DOC-ICP-15.03", "policy", "ltv", "network"],
          "description": "The LPA_PAdES, its signature and the policy document are downloaded from ITI's repository, the LPA's signature is checked, and the three go into the DSS.",
          "options": { "icpPolicy": "AdRa" },
          "expect": { "outcome": "signed", "level": "B-LTA", "indication": "TOTAL_PASSED" } },
        { "id": "ad-rb-crl-first", "title": "AD-RC collecting CRLs before OCSP", "tags": ["AD-RC", "DOC-ICP-15.03", "crl"],
          "description": "ICP-Brasil ACs publish CRLs; the revocation preference picks CRL first and OCSP as the fallback.",
          "options": { "icpPolicy": "AdRc", "revocationPreference": "CrlFirst" },
          "expect": { "outcome": "signed", "level": "B-LTA", "indication": "TOTAL_PASSED" } }
      ]
    },
    {
      "id": "modes",
      "title": "How the library is called",
      "description": "The same policies through the two-phase signer: the key signs elsewhere, as a token or a cloud certificate does (AD-RA embeds its artifacts and is made in one call only).",
      "steps": [
        { "id": "ad-rt-deferred", "title": "AD-RT in two phases", "tags": ["AD-RT", "deferred"], "engine": "library",
          "options": { "icpPolicy": "AdRt", "mode": "Deferred" },
          "expect": { "outcome": "signed", "level": "B-T", "indication": "TOTAL_PASSED" } },
        { "id": "ad-rc-deferred", "title": "AD-RC in two phases", "tags": ["AD-RC", "deferred"], "engine": "library",
          "options": { "icpPolicy": "AdRc", "mode": "Deferred" },
          "expect": { "outcome": "signed", "level": "B-LTA", "indication": "TOTAL_PASSED" } }
      ]
    },
    {
      "id": "revocation",
      "title": "Revocation before signing",
      "description": "The ICP-Brasil signing policy checks the revocation of the whole chain (CRL or OCSP) and refuses a certificate whose status is revoked or unknown.",
      "steps": [
        { "id": "crl-https-good", "title": "CRL over HTTPS, good certificate", "tags": ["revocation", "crl"],
          "options": { "credentialId": "sandbox:good-crl-https" }, "expect": { "outcome": "signed" } },
        { "id": "ocsp-good", "title": "OCSP, good certificate", "tags": ["revocation", "ocsp"],
          "options": { "credentialId": "sandbox:good-ocsp" }, "expect": { "outcome": "signed" } },
        { "id": "revoked-crl-https", "title": "Revoked, CRL over HTTPS: refused", "tags": ["revocation", "crl"],
          "options": { "credentialId": "sandbox:revoked-crl-https" }, "expect": { "outcome": "refused", "reason": "CertificateRevoked" } },
        { "id": "revoked-crl-ldap", "title": "Revoked, CRL over LDAP: refused", "tags": ["revocation", "crl", "ldap"],
          "options": { "credentialId": "sandbox:revoked-crl-ldap" }, "expect": { "outcome": "refused", "reason": "CertificateRevoked" } },
        { "id": "revoked-ocsp", "title": "Revoked, OCSP: refused", "tags": ["revocation", "ocsp"],
          "options": { "credentialId": "sandbox:revoked-ocsp" }, "expect": { "outcome": "refused", "reason": "CertificateRevoked" } },
        { "id": "revoked-ca", "title": "Under a revoked AC: refused", "tags": ["revocation"],
          "options": { "credentialId": "sandbox:under-revoked-ca" }, "expect": { "outcome": "refused", "reason": "CertificateRevoked" } },
        { "id": "crl-stale", "title": "Revoked after the CRL a client may have cached: refused", "tags": ["revocation", "crl"],
          "sandbox": { "revoke": ["rsa-4096"], "crl": "Stale" },
          "options": { "credentialId": "sandbox:rsa-4096" }, "expect": { "outcome": "refused", "reason": "CertificateRevoked" } },
        { "id": "crl-down", "title": "CRL server down, no OCSP: refused", "tags": ["revocation", "crl"],
          "sandbox": { "crl": "Down" },
          "options": { "credentialId": "sandbox:good-crl-https" }, "expect": { "outcome": "refused", "reason": "RevocationStatusUnknown" } },
        { "id": "crl-expired", "title": "Expired CRL: refused", "tags": ["revocation", "crl"],
          "sandbox": { "crl": "Expired" },
          "options": { "credentialId": "sandbox:good-crl-https" }, "expect": { "outcome": "refused", "reason": "RevocationStatusUnknown" } },
        { "id": "crl-wrong-key", "title": "CRL signed by another key: refused", "tags": ["revocation", "crl"],
          "sandbox": { "crl": "WrongKey" },
          "options": { "credentialId": "sandbox:good-crl-https" }, "expect": { "outcome": "refused", "reason": "RevocationStatusUnknown" } },
        { "id": "ocsp-unauthorized", "title": "OCSP response from an unauthorized signer, no CRL: refused", "tags": ["revocation", "ocsp"],
          "sandbox": { "ocsp": "Unauthorized" },
          "options": { "credentialId": "sandbox:good-ocsp" }, "expect": { "outcome": "refused", "reason": "RevocationStatusUnknown" } }
      ]
    },
    {
      "id": "validity",
      "title": "Certificate validity and purpose",
      "steps": [
        { "id": "expired", "title": "Expired certificate: refused", "tags": ["validity"],
          "options": { "credentialId": "sandbox:expired" }, "expect": { "outcome": "refused", "reason": "CertificateExpired" } },
        { "id": "not-yet-valid", "title": "Not yet valid certificate: refused", "tags": ["validity"],
          "options": { "credentialId": "sandbox:not-yet-valid" }, "expect": { "outcome": "refused", "reason": "CertificateNotCurrentlyValid" } },
        { "id": "expired-ca", "title": "Under an expired AC: refused", "tags": ["validity"],
          "options": { "credentialId": "sandbox:under-expired-ca" }, "expect": { "outcome": "refused", "reason": "ChainCertificateNotValid" } },
        { "id": "no-key-usage", "title": "Neither digitalSignature nor nonRepudiation: refused", "tags": ["key-usage"],
          "options": { "credentialId": "sandbox:no-signing-key-usage" }, "expect": { "outcome": "refused", "reason": "KeyUsageNotPermitted" } },
        { "id": "no-key-usage-extension", "title": "No KeyUsage extension: refused", "tags": ["key-usage"],
          "options": { "credentialId": "sandbox:no-key-usage-extension" }, "expect": { "outcome": "refused", "reason": "KeyUsageNotPermitted" } }
      ]
    },
    {
      "id": "act",
      "title": "Time-stamps (ACT)",
      "description": "AD-RT and above need a signature time-stamp. The ICP-Brasil signing policy checks the TSA before the signature is kept: it chains to an anchor, its certificate was valid at the time-stamp's time and is not revoked.",
      "steps": [
        { "id": "act-revoked", "title": "Revoked TSA: refused", "tags": ["AD-RT", "tsa"],
          "options": { "icpPolicy": "AdRt", "timestamp": { "provider": "SandboxRevoked" } },
          "expect": { "outcome": "refused", "reason": "TimestampCertificateRevoked" } },
        { "id": "act-expired", "title": "TSA with an expired certificate: refused", "tags": ["AD-RT", "tsa"],
          "options": { "icpPolicy": "AdRt", "timestamp": { "provider": "SandboxExpired" } },
          "expect": { "outcome": "refused", "reason": "TimestampCertificateNotValid" } },
        { "id": "act-untrusted", "title": "TSA outside the anchors: refused", "tags": ["AD-RT", "tsa"],
          "options": { "icpPolicy": "AdRt", "timestamp": { "provider": "SandboxUntrusted" } },
          "expect": { "outcome": "refused", "reason": "TimestampUntrusted" } },
        { "id": "act-down", "title": "TSA down: refused", "tags": ["AD-RT", "tsa"],
          "sandbox": { "tsa": "Down" },
          "options": { "icpPolicy": "AdRt" }, "expect": { "outcome": "refused", "reason": "NetworkFailure" } }
      ]
    },
    {
      "id": "algorithms",
      "title": "Keys and digests (DOC-ICP-01.01)",
      "steps": [
        { "id": "alg-rsa-4096-sha512", "title": "RSA 4096 with SHA-512", "tags": ["DOC-ICP-01.01", "algorithms"],
          "options": { "credentialId": "sandbox:rsa-4096", "hash": "Sha512" }, "expect": { "outcome": "signed", "indication": "TOTAL_PASSED" } },
        { "id": "alg-ecdsa-p256", "title": "ECDSA P-256 with SHA-256", "tags": ["DOC-ICP-01.01", "algorithms"],
          "options": { "credentialId": "sandbox:ecdsa-p256" }, "expect": { "outcome": "signed", "indication": "TOTAL_PASSED" } },
        { "id": "alg-ecdsa-p521", "title": "ECDSA P-521 with SHA-512", "tags": ["DOC-ICP-01.01", "algorithms"],
          "options": { "credentialId": "sandbox:ecdsa-p521", "hash": "Sha512" }, "expect": { "outcome": "signed", "indication": "TOTAL_PASSED" } },
        { "id": "alg-rsa-1024", "title": "RSA 1024 key: refused", "tags": ["DOC-ICP-01.01", "algorithms"],
          "options": { "credentialId": "sandbox:rsa-1024" }, "expect": { "outcome": "refused", "reason": "KeyTooWeak" } },
        { "id": "alg-sha1-ca", "title": "AC certificate signed with SHA-1: refused", "tags": ["DOC-ICP-01.01", "algorithms"],
          "options": { "credentialId": "sandbox:under-sha1-ca" }, "expect": { "outcome": "refused", "reason": "AlgorithmNotPermitted" } }
      ]
    },
    {
      "id": "pdf",
      "title": "PDF documents",
      "description": "What a PDF brings to an ICP-Brasil signature: a field to sign, a signature already there, a visible stamp, certification.",
      "steps": [
        { "id": "pdf-existing-field", "title": "Sign the document's empty signature field", "tags": ["AD-RB", "pdf"],
          "options": { "documentId": "sample:empty-field", "fieldMode": "Existing", "existingFieldName": "Assinatura" },
          "expect": { "outcome": "signed", "indication": "TOTAL_PASSED" } },
        { "id": "pdf-visible", "title": "AD-RT with a visible stamp", "tags": ["AD-RT", "pdf", "appearance"],
          "options": { "icpPolicy": "AdRt", "reason": "Concordo com o conteúdo", "location": "Brasília, DF",
            "appearance": { "visible": true, "autoPosition": true, "showDate": true, "showReason": true, "culture": "pt-BR",
              "timeZoneId": "America/Sao_Paulo", "dateFormat": "dd/MM/yyyy HH:mm", "signedByLabel": "Assinado digitalmente por" } },
          "expect": { "outcome": "signed", "level": "B-T", "indication": "TOTAL_PASSED" } },
        { "id": "pdf-second-signer", "title": "A second signer (AD-RT) over the AD-RB document", "tags": ["AD-RT", "pdf"],
          "options": { "documentId": "step:ad-rb", "icpPolicy": "AdRt", "credentialId": "sandbox:rsa-3072", "fieldName": "Assinatura2" },
          "expect": { "outcome": "signed", "level": "B-T", "indication": "TOTAL_PASSED" } },
        { "id": "pdf-certified", "title": "Certification signature (DocMDP, form filling allowed)", "tags": ["AD-RB", "pdf", "certification"],
          "options": { "certification": "FormFilling" },
          "expect": { "outcome": "signed", "indication": "TOTAL_PASSED" } }
      ]
    },
    {
      "id": "validation",
      "title": "Validation with the ICP-Brasil profile",
      "description": "The signatures above and the validation samples, validated with the ICP-Brasil validation policy (the default's constraints, and a signing certificate without digitalSignature or nonRepudiation fails).",
      "steps": [
        { "id": "v-ad-rb", "kind": "validate", "title": "AD-RB", "tags": ["AD-RB", "validation"],
          "options": { "fileId": "step:ad-rb", "settings": { "trust": [], "profile": "IcpBrasil", "trustProfiles": ["Sandbox"], "policyId": "preset:validation:icp-brasil" } }, "expect": { "outcome": "valid", "indication": "TOTAL_PASSED", "etsiReport": "valid" } },
        { "id": "v-ad-rt", "kind": "validate", "title": "AD-RT", "tags": ["AD-RT", "validation"],
          "options": { "fileId": "step:ad-rt", "settings": { "trust": [], "profile": "IcpBrasil", "trustProfiles": ["Sandbox"], "policyId": "preset:validation:icp-brasil" } }, "expect": { "outcome": "valid", "indication": "TOTAL_PASSED" } },
        { "id": "v-ad-rc", "kind": "validate", "title": "AD-RC at the archival level", "tags": ["AD-RC", "validation"],
          "options": { "fileId": "step:ad-rc", "settings": { "trust": [], "profile": "IcpBrasil", "trustProfiles": ["Sandbox"], "policyId": "preset:validation:icp-brasil", "level": "ArchivalData" } }, "expect": { "outcome": "valid", "indication": "TOTAL_PASSED" } },
        { "id": "v-ad-ra", "kind": "validate", "title": "AD-RA at the archival level", "tags": ["AD-RA", "validation", "network"],
          "options": { "fileId": "step:ad-ra", "settings": { "trust": [], "profile": "IcpBrasil", "trustProfiles": ["Sandbox"], "policyId": "preset:validation:icp-brasil", "level": "ArchivalData" } }, "expect": { "outcome": "valid", "indication": "TOTAL_PASSED" } },
        { "id": "v-two-signers", "kind": "validate", "title": "Two signers", "tags": ["AD-RT", "validation", "pdf"],
          "options": { "fileId": "step:pdf-second-signer", "settings": { "trust": [], "profile": "IcpBrasil", "trustProfiles": ["Sandbox"], "policyId": "preset:validation:icp-brasil" } }, "expect": { "outcome": "valid" } },
        { "id": "v-profile-only", "kind": "validate", "title": "Profile alone: the Sandbox's chain is not ICP-Brasil", "tags": ["validation", "trust"],
          "options": { "fileId": "step:ad-rb", "settings": { "trust": [], "profile": "IcpBrasil", "trustProfiles": [], "policyId": "preset:validation:icp-brasil" } },
          "expect": { "outcome": "indeterminate", "indication": "INDETERMINATE", "subIndication": "NO_CERTIFICATE_CHAIN_FOUND" } },
        { "id": "v-revoked-after-adrt", "kind": "validate", "title": "AD-RT: signer revoked after the time-stamp stays valid", "tags": ["AD-RT", "validation", "revocation"],
          "description": "The signature time-stamp proves the signature existed before the revocation.",
          "wait": 2, "sandbox": { "revoke": ["rsa-3072"] },
          "options": { "fileId": "step:pdf-second-signer", "settings": { "trust": [], "profile": "IcpBrasil", "trustProfiles": ["Sandbox"], "policyId": "preset:validation:icp-brasil" } }, "expect": { "outcome": "valid" } },
        { "id": "v-tampered", "kind": "validate", "title": "Document changed after signing", "tags": ["validation", "integrity"],
          "options": { "fileId": "sample:tampered-content", "settings": { "trust": [], "profile": "IcpBrasil", "trustProfiles": ["Sandbox"], "policyId": "preset:validation:icp-brasil" } }, "expect": { "outcome": "invalid", "indication": "TOTAL_FAILED", "subIndication": "HASH_FAILURE" } },
        { "id": "v-tampered-cms", "kind": "validate", "title": "Signature value changed", "tags": ["validation", "integrity"],
          "options": { "fileId": "sample:tampered-cms", "settings": { "trust": [], "profile": "IcpBrasil", "trustProfiles": ["Sandbox"], "policyId": "preset:validation:icp-brasil" } }, "expect": { "outcome": "invalid", "indication": "TOTAL_FAILED", "subIndication": "SIG_CRYPTO_FAILURE" } },
        { "id": "v-revoked", "kind": "validate", "title": "Signer revoked, no proof of existence before it", "tags": ["validation", "revocation"],
          "options": { "fileId": "sample:revoked", "settings": { "trust": [], "profile": "IcpBrasil", "trustProfiles": ["Sandbox"], "policyId": "preset:validation:icp-brasil" } }, "expect": { "outcome": "indeterminate", "indication": "INDETERMINATE", "subIndication": "REVOKED_NO_POE" } },
        { "id": "v-expired", "kind": "validate", "title": "Signer expired, no proof of existence", "tags": ["validation", "validity"],
          "options": { "fileId": "sample:expired", "settings": { "trust": [], "profile": "IcpBrasil", "trustProfiles": ["Sandbox"], "policyId": "preset:validation:icp-brasil" } }, "expect": { "outcome": "indeterminate", "indication": "INDETERMINATE", "subIndication": "OUT_OF_BOUNDS_NO_POE" } },
        { "id": "key-usage-file", "title": "Signer with neither digitalSignature nor nonRepudiation (minimal signing policy, to validate)", "tags": ["key-usage"],
          "options": { "credentialId": "sandbox:no-signing-key-usage", "signingPolicyId": "preset:signing:minimal", "validate": false },
          "expect": { "outcome": "signed" } },
        { "id": "v-key-usage", "kind": "validate", "title": "Signer with neither digitalSignature nor nonRepudiation: not accepted", "tags": ["validation", "key-usage"],
          "options": { "fileId": "step:key-usage-file", "settings": { "trust": [], "profile": "IcpBrasil", "trustProfiles": ["Sandbox"], "policyId": "preset:validation:icp-brasil" } }, "expect": { "outcome": "indeterminate", "indication": "INDETERMINATE" } }
      ]
    },
    {
      "id": "augment",
      "title": "Raising the level of an existing signature",
      "description": "An AD-RT signature brought to B-LTA later (validation data and a document time-stamp), as AD-RC needs.",
      "steps": [
        { "id": "aug-ad-rt", "kind": "augment", "title": "AD-RT to B-LTA", "tags": ["AD-RT", "AD-RC", "augment"], "engine": "library",
          "options": { "fileId": "step:ad-rt", "level": "BLTA", "timestamp": { "provider": "Sandbox" } },
          "expect": { "outcome": "augmented", "level": "B-LTA", "indication": "TOTAL_PASSED" } }
      ]
    }
  ]
}
