<Project Sdk="Microsoft.NET.Sdk">

  <!-- SimpleSign Desktop: exercises the whole library and runs the local signing agent (H1). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks></TargetFrameworks>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SimpleSign</AssemblyName>
    <RootNamespace>SimpleSign.Desktop</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AnalysisMode>Recommended</AnalysisMode>
    <!-- UI code resumes on the UI thread; strings are UI text. -->
    <NoWarn>$(NoWarn);CS1591;CA2007;CA1303;CA1515;CA1822;CA1848;CA1873</NoWarn>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon Condition="Exists('Assets\icon.ico')">Assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.5" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SimpleSign.Core\SimpleSign.Core.csproj" />
    <ProjectReference Include="..\SimpleSign.PAdES\SimpleSign.PAdES.csproj" />
    <ProjectReference Include="..\SimpleSign.CAdES\SimpleSign.CAdES.csproj" />
    <ProjectReference Include="..\SimpleSign.XAdES\SimpleSign.XAdES.csproj" />
    <ProjectReference Include="..\SimpleSign.Brasil\SimpleSign.Brasil.csproj" />
    <ProjectReference Include="..\SimpleSign.Brasil.Xades\SimpleSign.Brasil.Xades.csproj" />
    <ProjectReference Include="..\SimpleSign.Signers.Pkcs11\SimpleSign.Signers.Pkcs11.csproj" />
    <ProjectReference Include="..\SimpleSign.HtmlToPdf\SimpleSign.HtmlToPdf.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SimpleSign.Desktop.Tests" />
  </ItemGroup>
</Project>
