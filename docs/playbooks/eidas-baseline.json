{
  "$schema": "https://raw.githubusercontent.com/eupassarin/SimpleSign/main/docs/schemas/playbook.schema.json",
  "schema": 2,
  "id": "eidas-baseline",
  "title": "eIDAS: trusted lists and qualification",
  "description": "The eIDAS profile (SimpleSign.Europe.Eidas) against the Sandbox's list of trusted lists, through the library and the CLI: the faults of the LOTL and the TL, the qualification of each signature (QESig, QESeal, AdESig-QC, AdESig) and of its time-stamps (QTSA). Tags name the items of docs/playbooks/eidas-checklist.md. Not cross-validated with EU DSS: the TestBench does not compare DSS's qualification yet.",
  "defaults": {
    "engine": "both",
    "format": "pades",
    "crossValidate": false,
    "options": {
      "common": {
        "level": "BB",
        "credentialId": "sandbox:qc-esign-qscd",
        "signingPolicyId": "preset:signing:eidas",
        "signingControls": {
          "trust": [],
          "profile": "Eidas",
          "profileSource": "Sandbox"
        },
        "attemptRefused": true,
        "validation": {
          "trust": [],
          "profile": "Eidas",
          "profileSource": "Sandbox",
          "policyId": "preset:validation:eidas"
        }
      },
      "pades": {
        "documentId": "sample:contract"
      }
    }
  },
  "policies": [
    {
      "id": "eidas-qualified",
      "kind": "signing",
      "base": "eidas",
      "set": {
        "SigningCertificate/QcCompliance": {
          "Level": "FAIL"
        },
        "SigningCertificate/QcSSCD": {
          "Level": "FAIL"
        }
      }
    }
  ],
  "sections": [
    {
      "id": "lists",
      "title": "Trusted lists (LOTL and TL)",
      "description": "The anchors come from the Sandbox's LOTL and the list it points to, each checked against the certificate of its operator (the LOTL's, then the one the LOTL names). A list that is expired, signed by another key or changed gives no anchors: signing is refused, validation finds no chain. For validation an expired national list is kept and the eidas policy's TLNotExpired (FAIL) judges it; an expired LOTL is always refused.",
      "steps": [
        {
          "id": "tl-ok",
          "title": "Sign with a qualified certificate the Sandbox's lists vouch for",
          "tags": [
            "L-1",
            "L-2",
            "Q-1",
            "lists"
          ],
          "options": {},
          "expect": {
            "outcome": "signed",
            "qualification": "QESig"
          },
          "description": "The LOTL is checked with its operator's certificate, the TL with the one the LOTL names; the signer chains to the CA/QC service."
        },
        {
          "id": "tl-wrong-signer",
          "title": "TL signed by another key: refused",
          "tags": [
            "L-2",
            "lists"
          ],
          "options": {},
          "expect": {
            "outcome": "refused",
            "reason": "UntrustedRoot"
          },
          "sandbox": {
            "trustedList": "WrongSigner"
          }
        },
        {
          "id": "tl-tampered",
          "title": "TL changed after signing: refused",
          "tags": [
            "L-2",
            "lists"
          ],
          "options": {},
          "expect": {
            "outcome": "refused",
            "reason": "UntrustedRoot"
          },
          "sandbox": {
            "trustedList": "Tampered"
          }
        },
        {
          "id": "tl-expired",
          "title": "Expired TL: refused for signing",
          "tags": [
            "L-3",
            "lists"
          ],
          "options": {},
          "expect": {
            "outcome": "refused",
            "reason": "UntrustedRoot"
          },
          "sandbox": {
            "trustedList": "Expired"
          }
        },
        {
          "id": "lotl-wrong-signer",
          "title": "LOTL signed by another key: refused",
          "tags": [
            "L-1",
            "lists"
          ],
          "options": {},
          "expect": {
            "outcome": "refused",
            "reason": "UntrustedRoot"
          },
          "sandbox": {
            "lotl": "WrongSigner"
          }
        },
        {
          "id": "lotl-tampered",
          "title": "LOTL changed after signing: refused",
          "tags": [
            "L-1",
            "lists"
          ],
          "options": {},
          "expect": {
            "outcome": "refused",
            "reason": "UntrustedRoot"
          },
          "sandbox": {
            "lotl": "Tampered"
          }
        },
        {
          "id": "lotl-expired",
          "title": "Expired LOTL: refused",
          "tags": [
            "L-3",
            "lists"
          ],
          "options": {},
          "expect": {
            "outcome": "refused",
            "reason": "UntrustedRoot"
          },
          "sandbox": {
            "lotl": "Expired"
          }
        },
        {
          "id": "v-tl-ok",
          "kind": "validate",
          "title": "Validate under the eidas profile",
          "tags": [
            "L-1",
            "L-2",
            "Q-1",
            "lists"
          ],
          "options": {
            "fileId": "step:tl-ok",
            "settings": {
              "trust": [],
              "profile": "Eidas",
              "profileSource": "Sandbox",
              "policyId": "preset:validation:eidas"
            }
          },
          "expect": {
            "outcome": "valid",
            "indication": "TOTAL_PASSED",
            "qualification": "QESig"
          }
        },
        {
          "id": "v-tl-wrong-signer",
          "kind": "validate",
          "title": "Validate with a fake TL: no chain, not under eIDAS",
          "tags": [
            "L-2",
            "lists"
          ],
          "options": {
            "fileId": "step:tl-ok",
            "settings": {
              "trust": [],
              "profile": "Eidas",
              "profileSource": "Sandbox",
              "policyId": "preset:validation:eidas"
            }
          },
          "expect": {
            "outcome": "indeterminate",
            "subIndication": "NO_CERTIFICATE_CHAIN_FOUND",
            "qualification": "N/A"
          },
          "sandbox": {
            "trustedList": "WrongSigner"
          }
        },
        {
          "id": "v-tl-expired",
          "kind": "validate",
          "title": "Validate with an expired TL: TLNotExpired fails",
          "tags": [
            "L-3",
            "lists"
          ],
          "options": {
            "fileId": "step:tl-ok",
            "settings": {
              "trust": [],
              "profile": "Eidas",
              "profileSource": "Sandbox",
              "policyId": "preset:validation:eidas"
            }
          },
          "expect": {
            "outcome": "indeterminate",
            "subIndication": "TRY_LATER",
            "qualification": "Indeterminate QESig"
          },
          "sandbox": {
            "trustedList": "Expired"
          }
        },
        {
          "id": "v-lotl-wrong-signer",
          "kind": "validate",
          "title": "Validate with a fake LOTL: no chain",
          "tags": [
            "L-1",
            "lists"
          ],
          "options": {
            "fileId": "step:tl-ok",
            "settings": {
              "trust": [],
              "profile": "Eidas",
              "profileSource": "Sandbox",
              "policyId": "preset:validation:eidas"
            }
          },
          "expect": {
            "outcome": "indeterminate",
            "subIndication": "NO_CERTIFICATE_CHAIN_FOUND"
          },
          "sandbox": {
            "lotl": "WrongSigner"
          }
        }
      ]
    },
    {
      "id": "qualification",
      "title": "Qualification of the signature (TS 119 615, TS 119 172-4)",
      "description": "The CA/QC service of the Sandbox's TL, its Qualifications extension and the QC statements of each signer give the qualification of the signature: QESig and QESeal (qualified, key on a QSCD), AdESig-QC (qualified, no QSCD), AdESig (not qualified, or under a CA/PKC service).",
      "steps": [
        {
          "id": "q-adesig-qc",
          "title": "Qualified certificate without a QSCD",
          "tags": [
            "Q-1",
            "Q-3",
            "qualification"
          ],
          "options": {
            "credentialId": "sandbox:qc-esign"
          },
          "expect": {
            "outcome": "signed",
            "qualification": "AdESig-QC"
          }
        },
        {
          "id": "q-qeseal",
          "title": "Qualified seal certificate on a QSCD",
          "tags": [
            "Q-1",
            "Q-4",
            "qualification"
          ],
          "options": {
            "credentialId": "sandbox:qc-eseal-qscd"
          },
          "expect": {
            "outcome": "signed",
            "qualification": "QESeal"
          }
        },
        {
          "id": "q-qscd-by-list",
          "title": "QSCD declared by the trusted list (QCWithQSCD)",
          "tags": [
            "Q-2",
            "Q-3",
            "qualification"
          ],
          "options": {
            "credentialId": "sandbox:qc-esign-policy"
          },
          "expect": {
            "outcome": "signed",
            "qualification": "QESig"
          },
          "description": "The certificate has no QcSSCD, but its policy is QCP-n-qscd and the TL's Qualifications extension says QCWithQSCD for it."
        },
        {
          "id": "q-not-qualified",
          "title": "Certificate without QC statements",
          "tags": [
            "Q-1",
            "qualification"
          ],
          "options": {
            "credentialId": "sandbox:rsa-2048"
          },
          "expect": {
            "outcome": "signed",
            "qualification": "AdESig"
          }
        },
        {
          "id": "q-under-pkc",
          "title": "QC statements under a CA/PKC service",
          "tags": [
            "Q-5",
            "qualification"
          ],
          "options": {
            "credentialId": "sandbox:pkc-esign"
          },
          "expect": {
            "outcome": "signed",
            "qualification": "AdESig"
          },
          "description": "The certificate claims QcCompliance and QcSSCD, but its CA is listed as CA/PKC: the list does not vouch for it as qualified."
        },
        {
          "id": "q-policy-refuses",
          "title": "A policy that asks for a qualified certificate on a QSCD refuses a non-qualified one",
          "tags": [
            "Q-6",
            "qualification"
          ],
          "options": {
            "credentialId": "sandbox:rsa-2048",
            "signingPolicyId": "playbook:eidas-qualified"
          },
          "expect": {
            "outcome": "refused",
            "reason": "CertificateNotQualified"
          }
        },
        {
          "id": "q-policy-accepts",
          "title": "The same policy signs with a qualified certificate on a QSCD",
          "tags": [
            "Q-6",
            "qualification"
          ],
          "options": {
            "signingPolicyId": "playbook:eidas-qualified"
          },
          "expect": {
            "outcome": "signed",
            "qualification": "QESig"
          }
        }
      ]
    },
    {
      "id": "timestamps",
      "title": "Time-stamps (TSA/QTST)",
      "description": "A time-stamp is a qualified electronic time-stamp when a TSA/QTST service of the lists, granted at its time, issued it. The eidas signing policy refuses a TSA that is not trusted or whose certificate is revoked.",
      "steps": [
        {
          "id": "ts-qualified",
          "title": "B-T with the qualified TSA",
          "tags": [
            "T-1",
            "Q-1",
            "timestamps"
          ],
          "options": {
            "level": "BT",
            "timestamp": {
              "provider": "Sandbox"
            }
          },
          "expect": {
            "outcome": "signed",
            "qualification": "QESig",
            "level": "B-T",
            "timestampQualification": "QTSA"
          }
        },
        {
          "id": "ts-non-qualified",
          "title": "B-T with a non-qualified TSA (a TSA service)",
          "tags": [
            "T-2",
            "timestamps"
          ],
          "options": {
            "level": "BT",
            "timestamp": {
              "provider": "SandboxNonQualified"
            }
          },
          "expect": {
            "outcome": "signed",
            "qualification": "QESig",
            "level": "B-T",
            "timestampQualification": "TSA"
          }
        },
        {
          "id": "ts-revoked",
          "title": "B-T with the withdrawn TSA, whose certificate is revoked: refused",
          "tags": [
            "T-3",
            "timestamps"
          ],
          "options": {
            "level": "BT",
            "timestamp": {
              "provider": "SandboxRevoked"
            }
          },
          "expect": {
            "outcome": "refused",
            "reason": "TimestampCertificateRevoked"
          }
        },
        {
          "id": "ts-untrusted",
          "title": "B-T with a TSA outside the lists: refused",
          "tags": [
            "T-3",
            "timestamps"
          ],
          "options": {
            "level": "BT",
            "timestamp": {
              "provider": "SandboxUntrusted"
            }
          },
          "expect": {
            "outcome": "refused",
            "reason": "TimestampUntrusted"
          }
        },
        {
          "id": "v-withdrawn-after-use",
          "kind": "validate",
          "title": "CA/QC withdrawn after the signature: still qualified by its history",
          "tags": [
            "L-4",
            "Q-1",
            "T-1",
            "timestamps"
          ],
          "options": {
            "fileId": "step:ts-qualified",
            "settings": {
              "trust": [],
              "profile": "Eidas",
              "profileSource": "Sandbox",
              "policyId": "preset:validation:eidas"
            }
          },
          "expect": {
            "outcome": "valid",
            "qualification": "QESig",
            "timestampQualification": "QTSA"
          },
          "description": "The time-stamp proves the signature existed while the root's CA/QC service was granted (its ServiceHistory).",
          "sandbox": {
            "trustedList": "WithdrawnAfterUse"
          }
        }
      ]
    }
  ]
}
