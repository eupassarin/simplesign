<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SimpleSign.Desktop.ViewModels"
             xmlns:s="using:SimpleSign.Desktop.Services"
             xmlns:c="using:SimpleSign.Desktop.Controls"
             xmlns:v="using:SimpleSign.Desktop.Views"
             x:Class="SimpleSign.Desktop.Views.InspectView"
             x:DataType="vm:InspectViewModel">
  <StackPanel Spacing="16">
    <c:PageChrome />
    <c:DropZone FileName="{Binding FileName}" Hint="Um PDF · ou clique para escolher" />
    <Border Classes="card" IsVisible="{Binding HasFile}">
      <StackPanel Spacing="10">
        <TextBlock Classes="title" Text="Documento" />
        <ItemsControl ItemsSource="{Binding Document}">
          <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="s:DetailItem">
                      <Grid ColumnDefinitions="200,*" Margin="0,3">
                        <TextBlock Classes="caption" Text="{Binding Key}" />
                        <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
    <ItemsControl ItemsSource="{Binding Signatures}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="14" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:InspectedSignature">
          <Border Classes="card">
            <StackPanel Spacing="10">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Extrair CMS (.p7s)…"
                        Command="{Binding $parent[ItemsControl].((vm:InspectViewModel)DataContext).ExtractCommand}" CommandParameter="{Binding}" />
                <TextBlock Classes="title" Text="{Binding Name}" VerticalAlignment="Center" />
              </DockPanel>
              <ItemsControl ItemsSource="{Binding Details}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="s:DetailItem">
                      <Grid ColumnDefinitions="200,*" Margin="0,3">
                        <TextBlock Classes="caption" Text="{Binding Key}" />
                        <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
