<Project Sdk="Microsoft.NET.Sdk">
  <!-- Generates src/Brasil/SimpleSign.Brasil/IcpBrasil/IcpBrasilPolicyRules.Catalog.cs from the ITI PA files.
       Usage: see Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <!-- A dev tool, not shipped: relax the repository-wide analysis settings. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <AnalysisMode>Default</AnalysisMode>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Brasil\SimpleSign.Brasil\SimpleSign.Brasil.csproj" />
  </ItemGroup>
</Project>
