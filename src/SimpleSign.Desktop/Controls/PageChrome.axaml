<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SimpleSign.Desktop.ViewModels"
             xmlns:v="using:SimpleSign.Desktop.Views"
             x:Class="SimpleSign.Desktop.Controls.PageChrome"
             x:DataType="vm:PageViewModel">
  <!-- Page header with icon tile, title, subtitle, and the busy / error / status banners. -->
  <StackPanel Spacing="16" Margin="0,0,0,20">
    <StackPanel Orientation="Horizontal" Spacing="14">
      <Border Width="46" Height="46" CornerRadius="12" Background="{DynamicResource App.AccentSoft}">
        <Path Classes="icon" Width="24" Height="24" Data="{Binding IconKey, Converter={x:Static v:Converters.IconByKey}}" />
      </Border>
      <StackPanel VerticalAlignment="Center" Spacing="2">
        <TextBlock Classes="largeTitle" Text="{Binding Title}" />
        <TextBlock Classes="subtitle" Text="{Binding Subtitle}" />
      </StackPanel>
    </StackPanel>
    <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" Height="3" MinHeight="3" />
    <Border Classes="group" Background="{DynamicResource App.DangerSoft}" IsVisible="{Binding ErrorMessage, Converter={x:Static v:Converters.NotNull}}">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Path Classes="icon" Stroke="{DynamicResource App.Danger}" Data="{StaticResource Icon.Warning}" />
        <SelectableTextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{DynamicResource App.Danger}" MaxWidth="820" />
      </StackPanel>
    </Border>
    <Border Classes="group" Background="{DynamicResource App.SuccessSoft}" IsVisible="{Binding StatusMessage, Converter={x:Static v:Converters.NotNull}}">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Path Classes="icon" Stroke="{DynamicResource App.Success}" Data="{StaticResource Icon.Check}" />
        <SelectableTextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" Foreground="{DynamicResource App.Success}" MaxWidth="820" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
