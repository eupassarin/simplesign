<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>SimpleSign.Brazil.IcpBrasil.Xades</AssemblyName>
    <RootNamespace>SimpleSign.Brazil.IcpBrasil.Xades</RootNamespace>
    <PackageId>SimpleSign.Brazil.IcpBrasil.Xades</PackageId>
