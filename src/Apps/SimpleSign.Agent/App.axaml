<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SimpleSign.Agent.App"
             Name="SimpleSign Agent"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://SimpleSign.Agent/Styles/Theme.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#18181B" RegionColor="#FFFFFF" />
        <ColorPaletteResources x:Key="Dark" Accent="#E4E4E7" RegionColor="#09090B" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://SimpleSign.Agent/Styles/Controls.axaml" />
  </Application.Styles>
</Application>
