<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SimpleSign.Agent.Views.PromptWindow"
        Width="400" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False"
        Background="{DynamicResource App.Content}" Title="SimpleSign">
  <StackPanel Margin="24" Spacing="14">
    <Path Classes="icon" Data="{StaticResource Icon.Token}" Width="30" Height="30" HorizontalAlignment="Left" Name="Glyph" />
    <TextBlock Name="TitleText" Classes="title" FontSize="17" />
    <TextBlock Name="MessageText" Classes="subtitle" />
    <TextBox Name="SecretBox" PasswordChar="●" Watermark="••••••" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
      <Button Name="CancelButton" Content="Cancelar" IsCancel="True" />
      <Button Name="ConfirmButton" Classes="accent" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
