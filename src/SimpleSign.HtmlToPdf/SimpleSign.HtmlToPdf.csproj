<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>SimpleSign.HtmlToPdf</AssemblyName>
    <RootNamespace>SimpleSign.HtmlToPdf</RootNamespace>
    <PackageId>SimpleSign.HtmlToPdf</PackageId>
    <Description>Pure .NET HTML-to-PDF converter for documents. Zero browser dependency. CSS cascade with complex selectors, floats, flexbox, grid, paginated tables with repeated headers, subset Unicode TrueType/OpenType fonts, PNG/JPEG images, and PDF/A-2b output. Integrates with the SimpleSign signing pipeline.</Description>
    <PackageTags>html-to-pdf;pdf-generation;html2pdf;pdfa;css;native-aot</PackageTags>
    <Version>0.9.3</Version>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net9.0'))">true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SimpleSign.HtmlToPdf.Tests" />
  </ItemGroup>


  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.403" PrivateAssets="all" />
  </ItemGroup>
</Project>
