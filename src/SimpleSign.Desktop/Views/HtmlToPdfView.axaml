<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SimpleSign.Desktop.ViewModels"
             xmlns:s="using:SimpleSign.Desktop.Services"
             xmlns:c="using:SimpleSign.Desktop.Controls"
             xmlns:v="using:SimpleSign.Desktop.Views"
             x:Class="SimpleSign.Desktop.Views.HtmlToPdfView"
             x:DataType="vm:HtmlToPdfViewModel">
  <StackPanel Spacing="16">
    <c:PageChrome />
    <Border Classes="card">
      <StackPanel Spacing="12">
        <TextBox Watermark="Título do documento" Text="{Binding Title}" />
        <TextBox Text="{Binding Html}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="320" FontFamily="{StaticResource App.MonoFont}" FontSize="12.5" />
        <Button Classes="accent" HorizontalAlignment="Right" Content="Converter e salvar PDF…" Command="{Binding ConvertCommand}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
