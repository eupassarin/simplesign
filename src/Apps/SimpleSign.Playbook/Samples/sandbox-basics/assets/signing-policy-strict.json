{
  "$schema": "https://raw.githubusercontent.com/eupassarin/SimpleSign/main/docs/schemas/signing-policy.schema.json",
  "SigningConstraints": {
    "Name": "Default + revocation of the chain",
    "Description": "SimpleSign's default signing checks plus the revocation of the whole chain before signing (OCSP first, then a fresh CRL): a revoked certificate or an unknown status refuses the signature.",
    "SigningCertificate": {
      "NotExpired": { "Level": "FAIL" },
      "RevocationDataAvailable": { "Level": "FAIL" },
      "KeyUsage": { "Level": "FAIL", "Id": [ "digitalSignature", "nonRepudiation" ] },
      "NotRevoked": { "Level": "FAIL" }
    },
    "CACertificate": {
      "NotExpired": { "Level": "FAIL" },
      "RevocationDataAvailable": { "Level": "FAIL" },
      "NotRevoked": { "Level": "FAIL" }
    },
    "Cryptographic": {
      "Level": "FAIL",
      "AcceptableEncryptionAlgo": { "Algo": [ "RSA", "RSASSA-PSS", "ECDSA" ] },
      "MiniPublicKeySize": { "Algo": [ { "Value": "RSA", "Size": 2048 }, { "Value": "RSASSA-PSS", "Size": 2048 }, { "Value": "ECDSA", "Size": 256 } ] },
      "AcceptableDigestAlgo": { "Algo": [ "SHA256", "SHA384", "SHA512", "SHA3-256", "SHA3-384", "SHA3-512" ] }
    }
  }
}
