<Project Sdk="Microsoft.NET.Sdk">

  <!-- SimpleSign Agent: a tray app with a window that lets web pages request signatures with the user's certificates (H1). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks></TargetFrameworks>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SimpleSign.Agent</AssemblyName>
    <RootNamespace>SimpleSign.Agent</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AnalysisMode>Recommended</AnalysisMode>
    <!-- UI code resumes on the UI thread; strings are UI text. -->
    <NoWarn>$(NoWarn);CS1591;CA2007;CA1303;CA1515;CA1822;CA1848;CA1873</NoWarn>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon Condition="Exists('Assets\icon.ico')">Assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <!-- The trim and AOT analyzers run on every build, so a publish does not find surprises. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!--
    Small and fast: a publish for a runtime (-r osx-arm64, win-x64…) produces one native
    executable (Native AOT), without the .NET runtime or a JIT. Only then, so `dotnet run` and the
    tests keep using the installed runtime.
    RuntimeFrameworkVersion pins the runtime pack and ILCompiler to a patched servicing release:
    the ones bundled with SDK 10.0.300 (10.0.8) are affected by GHSA-p3jp-9v83-76w9 (NU1903).
    Same pin as tests/smoke/SimpleSign.AotSmokeTest; bump on new servicing releases.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishAot>true</PublishAot>
    <RuntimeFrameworkVersion>10.0.14</RuntimeFrameworkVersion>
    <OptimizationPreference>Size</OptimizationPreference>
    <StackTraceSupport>false</StackTraceSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <DebuggerSupport>false</DebuggerSupport>
  </PropertyGroup>

  <ItemGroup>
    <!-- The built-in documentation: Docs/<language>/<topic>.md, read by DocLibrary. -->
    <EmbeddedResource Include="Docs\**\*.md" WithCulture="false"
                      LogicalName="Docs/$([System.String]::Copy('%(RecursiveDir)').Replace('\', '/'))%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\SimpleSign.Core\SimpleSign.Core.csproj" />
    <ProjectReference Include="..\..\TrustFrameworks\Brazil\IcpBrasil\SimpleSign.Brazil.IcpBrasil\SimpleSign.Brazil.IcpBrasil.csproj" />
    <ProjectReference Include="..\..\TrustFrameworks\Brazil\GovBr\SimpleSign.Brazil.GovBr\SimpleSign.Brazil.GovBr.csproj" />
    <ProjectReference Include="..\..\TrustFrameworks\Peru\Iofe\SimpleSign.Peru.Iofe\SimpleSign.Peru.Iofe.csproj" />
    <ProjectReference Include="..\..\TrustFrameworks\Europe\Eidas\SimpleSign.Europe.Eidas\SimpleSign.Europe.Eidas.csproj" />
    <ProjectReference Include="..\..\Signers\SimpleSign.Signers.Pkcs11\SimpleSign.Signers.Pkcs11.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SimpleSign.Agent.Tests" />
  </ItemGroup>
</Project>
