{
  "$schema": "https://raw.githubusercontent.com/eupassarin/SimpleSign/main/docs/schemas/playbook.schema.json",
  "schema": 2,
  "id": "sandbox-basics",
  "title": "Sandbox basics",
  "description": "A full tour of the connected Sandbox: every signer of its good chain in PAdES, CAdES and XAdES; each of its TSAs; CRLs over HTTP, HTTPS and LDAP and its OCSP responder, with every failure they can be switched to; revocations made on demand; short-lived certificates; its trusted list and the IOFE profile read from it; and the cases a signer must refuse or a validator must not accept.",
  "defaults": {
    "engine": "library",
    "format": "pades",
    "options": {
      "common": {
        "credentialId": "sandbox:rsa-2048",
        "level": "BB",
        "signingPolicyId": "playbook:sandbox-strict",
        "signingControls": { "trust": ["SandboxRoot"] },
        "attemptRefused": true
      },
      "pades": { "documentId": "sample:contract" },
      "cades": { "dataId": "cades-sample:text" },
      "xades": { "dataId": "xades-sample:order" }
    }
  },
  "policies": [
    {
      "id": "sandbox-strict",
      "kind": "signing",
      "base": "strict",
      "set": {
        "SigningCertificate/ProspectiveCertificateChain": { "Level": "FAIL" },
        "SigningCertificate/CRLNextUpdatePresent": { "Level": "FAIL" },
        "CACertificate/CRLNextUpdatePresent": { "Level": "FAIL" },
        "Timestamp/ProspectiveCertificateChain": { "Level": "FAIL" },
        "Timestamp/NotExpired": { "Level": "FAIL" },
        "Timestamp/NotRevoked": { "Level": "FAIL" },
        "Timestamp/RevocationDataAvailable": { "Level": "FAIL" }
      }
    },
    {
      "id": "tsa-name",
      "kind": "validation",
      "base": "default",
      "set": {
        "Timestamp/TSAGeneralNameContentMatch": { "Level": "FAIL" }
      }
    }
  ],
  "sections": [
    {
      "id": "signers",
      "title": "Signers of the good chain",
      "description": "Every key the Sandbox issues under its intermediate CA signs with the strict policy.",
      "steps": [
        { "id": "sign-basic", "title": "RSA 2048, B-B", "tags": ["signers", "rsa"],
          "expect": { "outcome": "signed", "level": "B-B" } },
        { "id": "sign-rsa-3072", "title": "RSA 3072", "tags": ["signers", "rsa"],
          "options": { "credentialId": "sandbox:rsa-3072" }, "expect": { "outcome": "signed", "level": "B-B" } },
        { "id": "sign-rsa-4096", "title": "RSA 4096", "tags": ["signers", "rsa"],
          "options": { "credentialId": "sandbox:rsa-4096" }, "expect": { "outcome": "signed", "level": "B-B" } },
        { "id": "sign-ecdsa-p256", "title": "ECDSA P-256", "tags": ["signers", "ecdsa"],
          "options": { "credentialId": "sandbox:ecdsa-p256" }, "expect": { "outcome": "signed", "level": "B-B" } },
        { "id": "sign-ecdsa-p384", "title": "ECDSA P-384", "tags": ["signers", "ecdsa"],
          "options": { "credentialId": "sandbox:ecdsa-p384" }, "expect": { "outcome": "signed", "level": "B-B" } },
        { "id": "sign-ecdsa-p521", "title": "ECDSA P-521", "tags": ["signers", "ecdsa"],
          "options": { "credentialId": "sandbox:ecdsa-p521" }, "expect": { "outcome": "signed", "level": "B-B" } },
        { "id": "sign-rsa-pss", "title": "RSASSA-PSS with SHA-512", "tags": ["signers", "rsa", "algorithms"],
          "options": { "padding": "Pss", "hash": "Sha512" }, "expect": { "outcome": "signed", "level": "B-B" } },
        { "id": "validate-basic", "kind": "validate", "title": "Validate the RSA 2048 signature", "tags": ["signers", "validation"],
          "options": { "fileId": "step:sign-basic", "settings": { "trust": ["Sandbox"] } },
          "expect": { "outcome": "valid", "indication": "TOTAL_PASSED" } },
        { "id": "validate-ecdsa-p521", "kind": "validate", "title": "Validate the ECDSA P-521 signature", "tags": ["signers", "ecdsa", "validation"],
          "options": { "fileId": "step:sign-ecdsa-p521", "settings": { "trust": ["Sandbox"] } },
          "expect": { "outcome": "valid", "indication": "TOTAL_PASSED" } }
      ]
    },
    {
      "id": "formats",
      "title": "PAdES, CAdES and XAdES up to B-LTA",
      "description": "The three formats at B-LT and B-LTA through the Sandbox's TSA, CRLs and OCSP, each validated afterwards.",
      "steps": [
        { "id": "sign-lt", "title": "PAdES B-LT", "tags": ["formats", "pades", "tsa", "dss"],
          "description": "Also validated by EU DSS when one is connected (crossValidate); without DSS the step still runs and says so.",
          "crossValidate": true,
          "options": { "level": "BLT", "timestamp": { "provider": "Sandbox" } },
          "expect": { "outcome": "signed", "level": "B-LT" } },
        { "id": "validate-lt", "kind": "validate", "title": "Validate the PAdES B-LT signature", "tags": ["formats", "pades", "validation"],
          "options": { "fileId": "step:sign-lt", "settings": { "trust": ["Sandbox"] } }, "expect": { "outcome": "valid", "indication": "TOTAL_PASSED" } },
        { "id": "pades-blta", "title": "PAdES B-LTA", "tags": ["formats", "pades", "tsa"],
          "options": { "level": "BLTA", "timestamp": { "provider": "Sandbox" } },
          "expect": { "outcome": "signed", "level": "B-LTA" } },
        { "id": "validate-pades-blta", "kind": "validate", "title": "Validate the PAdES B-LTA signature (archival data)", "tags": ["formats", "pades", "validation"],
          "options": { "fileId": "step:pades-blta", "settings": { "trust": ["Sandbox"], "level": "ArchivalData" } },
          "expect": { "outcome": "valid", "indication": "TOTAL_PASSED" } },
        { "id": "pades-augment-blta", "kind": "augment", "title": "Augment the B-B signature to B-LTA", "tags": ["formats", "pades", "augment", "tsa"],
          "options": { "fileId": "step:sign-basic", "level": "BLTA", "timestamp": { "provider": "Sandbox" } },
          "expect": { "outcome": "augmented", "level": "B-LTA" } },
        { "id": "cades-blt", "format": "cades", "title": "CAdES B-LT, detached", "tags": ["formats", "cades", "tsa"],
          "options": { "level": "BLT", "timestamp": { "provider": "Sandbox" } },
          "expect": { "outcome": "signed", "level": "B-LT" } },
        { "id": "cades-blta-enveloped", "format": "cades", "title": "CAdES B-LTA, enveloped, ECDSA P-384", "tags": ["formats", "cades", "ecdsa", "tsa"],
          "options": { "credentialId": "sandbox:ecdsa-p384", "contentType": "Enveloped", "level": "BLTA", "timestamp": { "provider": "Sandbox" } },
          "expect": { "outcome": "signed", "level": "B-LTA" } },
        { "id": "validate-cades-blt", "kind": "validate", "title": "Validate the CAdES B-LT signature", "tags": ["formats", "cades", "validation"],
          "options": { "fileId": "step:cades-blt", "dataId": "cades-sample:text", "settings": { "trust": ["Sandbox"] } }, "expect": { "outcome": "valid", "indication": "TOTAL_PASSED" } },
        { "id": "validate-cades-blta", "kind": "validate", "title": "Validate the CAdES B-LTA signature", "tags": ["formats", "cades", "validation"],
          "options": { "fileId": "step:cades-blta-enveloped", "settings": { "trust": ["Sandbox"] } }, "expect": { "outcome": "valid", "indication": "TOTAL_PASSED" } },
        { "id": "xades-blt", "format": "xades", "title": "XAdES B-LT, enveloped", "tags": ["formats", "xades", "tsa"],
          "options": { "level": "BLT", "timestamp": { "provider": "Sandbox" } },
          "expect": { "outcome": "signed", "level": "B-LT" } },
        { "id": "xades-blta-enveloping", "format": "xades", "title": "XAdES B-LTA, enveloping, ECDSA P-256", "tags": ["formats", "xades", "ecdsa", "tsa"],
          "options": { "credentialId": "sandbox:ecdsa-p256", "form": "Enveloping", "level": "BLTA", "timestamp": { "provider": "Sandbox" } },
          "expect": { "outcome": "signed", "level": "B-LTA" } },
        { "id": "validate-xades-blt", "kind": "validate", "title": "Validate the XAdES B-LT signature", "tags": ["formats", "xades", "validation"],
          "options": { "fileId": "step:xades-blt", "settings": { "trust": ["Sandbox"] } }, "expect": { "outcome": "valid", "indication": "TOTAL_PASSED" } },
        { "id": "validate-xades-blta", "kind": "validate", "title": "Validate the XAdES B-LTA signature", "tags": ["formats", "xades", "validation"],
          "options": { "fileId": "step:xades-blta-enveloping", "settings": { "trust": ["Sandbox"] } }, "expect": { "outcome": "valid", "indication": "TOTAL_PASSED" } }
      ]
    },
    {
      "id": "tsa",
      "title": "Time-stamping authorities",
      "description": "Each TSA endpoint of the Sandbox and each failure its TSA can be switched to.",
      "steps": [
        { "id": "tsa-ok", "title": "TSA (/tsa/tsr), the expected one", "tags": ["tsa"],
          "options": { "level": "BT", "timestamp": { "provider": "Sandbox" }, "signingControls": { "trust": ["SandboxRoot"], "expectedTsa": "tsa" } },
          "expect": { "outcome": "signed", "level": "B-T" } },
        { "id": "tsa-authenticated", "title": "TSA with HTTP Basic (/tsa/authenticated)", "tags": ["tsa"],
          "options": { "level": "BT", "timestamp": { "provider": "SandboxAuthenticated" } },
          "expect": { "outcome": "signed", "level": "B-T" } },
        { "id": "tsa-short-lived", "title": "TSA with a short-lived certificate", "tags": ["tsa", "short-lived"],
          "options": { "level": "BT", "timestamp": { "provider": "SandboxShortLived" } },
          "expect": { "outcome": "signed", "level": "B-T" } },
        { "id": "tsa-cades", "format": "cades", "title": "CAdES B-T with a content timestamp", "tags": ["tsa", "cades"],
          "options": { "level": "BT", "timestamp": { "provider": "Sandbox" }, "contentTimestamp": true },
          "expect": { "outcome": "signed", "level": "B-T" } },
        { "id": "tsa-xades", "format": "xades", "title": "XAdES B-T with a data objects timestamp", "tags": ["tsa", "xades"],
          "options": { "level": "BT", "timestamp": { "provider": "Sandbox" }, "dataObjectsTimestamp": true },
          "expect": { "outcome": "signed", "level": "B-T" } },
        { "id": "tsa-unexpected", "title": "Not the TSA the signer expects", "tags": ["tsa"],
          "options": { "level": "BT", "timestamp": { "provider": "Sandbox" }, "signingControls": { "trust": ["SandboxRoot"], "expectedTsa": "tsa-revoked" } },
          "expect": { "outcome": "refused", "reason": "TimestampUntrusted" } },
        { "id": "tsa-revoked", "title": "TSA whose certificate is revoked (/tsa/revoked)", "tags": ["tsa", "revocation"],
          "options": { "level": "BT", "timestamp": { "provider": "SandboxRevoked" } },
          "expect": { "outcome": "refused", "reason": "TimestampCertificateRevoked" } },
        { "id": "tsa-expired", "title": "TSA whose certificate expired (/tsa/expired)", "tags": ["tsa", "validity"],
          "options": { "level": "BT", "timestamp": { "provider": "SandboxExpired" } },
          "expect": { "outcome": "refused", "reason": "TimestampCertificateNotValid" } },
        { "id": "tsa-outside-chain", "title": "TSA outside every trust anchor", "tags": ["tsa", "trust"],
          "options": { "level": "BT", "timestamp": { "provider": "SandboxUntrusted" } },
          "expect": { "outcome": "refused", "reason": "TimestampUntrusted" } },
        { "id": "tsa-wrong-name", "title": "TSA whose tokens name another TSA", "tags": ["tsa"],
          "description": "The checks before signing look at the TSA's chain, not at the tsa field of its tokens: the signature is made, and the validator flags the name.",
          "options": { "level": "BT", "timestamp": { "provider": "SandboxWrongName" } },
          "expect": { "outcome": "signed", "level": "B-T" } },
        { "id": "validate-tsa-wrong-name", "kind": "validate", "title": "Validate it: the TSA name does not match its certificate", "tags": ["tsa", "validation"],
          "options": { "fileId": "step:tsa-wrong-name", "settings": { "trust": ["Sandbox"], "policyId": "playbook:tsa-name" } },
          "expect": { "failedConstraints": ["TSAGeneralNameContentMatch"] } },
        { "id": "tsa-iofe-unlisted", "title": "TSA under its own CA, without the IOFE profile", "tags": ["tsa", "trust", "iofe"],
          "options": { "level": "BT", "timestamp": { "provider": "SandboxIofe" } },
          "expect": { "outcome": "refused", "reason": "TimestampUntrusted" } },
        { "id": "tsa-iofe-listed", "title": "TSA under its own CA, trusted through the IOFE profile", "tags": ["tsa", "trust", "iofe", "trusted-list"],
          "options": { "level": "BT", "timestamp": { "provider": "SandboxIofe" },
            "signingControls": { "trust": [], "profile": "Iofe", "profileSource": "Sandbox" } },
          "expect": { "outcome": "signed", "level": "B-T" } },
        { "id": "tsa-down", "title": "TSA down", "tags": ["tsa", "faults"],
          "sandbox": { "tsa": "Down" },
          "options": { "level": "BT", "timestamp": { "provider": "Sandbox" } },
          "expect": { "outcome": "refused" } },
        { "id": "tsa-down-lower-level", "title": "TSA down, signing at the highest level reached", "tags": ["tsa", "faults"],
          "sandbox": { "tsa": "Down" },
          "options": { "level": "BT", "timestamp": { "provider": "Sandbox" }, "returnLowerLevel": true },
          "expect": { "outcome": "signed", "level": "B-B" } },
        { "id": "tsa-slow", "title": "TSA slow (3 s)", "tags": ["tsa", "faults"],
          "sandbox": { "tsa": "Slow" },
          "options": { "level": "BT", "timestamp": { "provider": "Sandbox" } },
          "expect": { "outcome": "signed", "level": "B-T" } },
        { "id": "tsa-invalid-token", "title": "TSA answers a corrupted token", "tags": ["tsa", "faults"],
          "sandbox": { "tsa": "InvalidToken" },
          "options": { "level": "BT", "timestamp": { "provider": "Sandbox" } },
          "expect": { "outcome": "refused" } },
        { "id": "tsa-untrusted-token", "title": "TSA answers a token signed outside every trust anchor", "tags": ["tsa", "faults", "trust"],
          "sandbox": { "tsa": "Untrusted" },
          "options": { "level": "BT", "timestamp": { "provider": "Sandbox" } },
          "expect": { "outcome": "refused", "reason": "TimestampUntrusted" } }
      ]
    },
    {
      "id": "crl",
      "title": "CRLs over HTTP, HTTPS and LDAP",
      "description": "Certificates whose only revocation source is a CRL, and every failure the CRL server can be switched to.",
      "steps": [
        { "id": "crl-https-good", "title": "Good, CRL over HTTPS", "tags": ["crl", "https"],
          "options": { "credentialId": "sandbox:good-crl-https" }, "expect": { "outcome": "signed", "level": "B-B" } },
        { "id": "revoked-crl-https", "title": "Revoked, CRL over HTTPS", "tags": ["crl", "https", "revocation"],
          "options": { "credentialId": "sandbox:revoked-crl-https" }, "expect": { "outcome": "refused", "reason": "CertificateRevoked" } },
        { "id": "crl-ldap-good", "title": "Good, CRL over LDAP", "tags": ["crl", "ldap"],
          "options": { "credentialId": "sandbox:good-crl-ldap" }, "expect": { "outcome": "signed", "level": "B-B" } },
        { "id": "revoked-crl-ldap", "title": "Revoked, CRL over LDAP", "tags": ["crl", "ldap", "revocation"],
          "options": { "credentialId": "sandbox:revoked-crl-ldap" }, "expect": { "outcome": "refused", "reason": "CertificateRevoked" } },
        { "id": "crl-https-blt", "title": "B-LT with the CRL fetched over HTTPS", "tags": ["crl", "https", "tsa"],
          "options": { "credentialId": "sandbox:good-crl-https", "level": "BLT", "timestamp": { "provider": "Sandbox" } },
          "expect": { "outcome": "signed", "level": "B-LT" } },
        { "id": "validate-crl-https-blt", "kind": "validate", "title": "Validate the B-LT signature with its embedded CRL", "tags": ["crl", "validation"],
          "options": { "fileId": "step:crl-https-blt", "settings": { "trust": ["Sandbox"] } }, "expect": { "outcome": "valid", "indication": "TOTAL_PASSED" } },
        { "id": "crl-down", "title": "CRL server down, no OCSP", "tags": ["crl", "faults"],
          "sandbox": { "crl": "Down" },
          "options": { "credentialId": "sandbox:good-crl-https" }, "expect": { "outcome": "refused", "reason": "RevocationStatusUnknown" } },
        { "id": "crl-ldap-down", "title": "LDAP directory busy, no OCSP", "tags": ["crl", "ldap", "faults"],
          "sandbox": { "crl": "Down" },
          "options": { "credentialId": "sandbox:good-crl-ldap" }, "expect": { "outcome": "refused", "reason": "RevocationStatusUnknown" } },
        { "id": "crl-slow", "title": "CRL server slow (3 s)", "tags": ["crl", "faults"],
          "sandbox": { "crl": "Slow" },
          "options": { "credentialId": "sandbox:good-crl-https" }, "expect": { "outcome": "signed", "level": "B-B" } },
        { "id": "crl-expired", "title": "CRL past its nextUpdate", "tags": ["crl", "faults"],
          "sandbox": { "crl": "Expired" },
          "options": { "credentialId": "sandbox:good-crl-https" }, "expect": { "outcome": "refused", "reason": "RevocationStatusUnknown" } },
        { "id": "crl-wrong-key", "title": "CRL signed by another key", "tags": ["crl", "faults"],
          "sandbox": { "crl": "WrongKey" },
          "options": { "credentialId": "sandbox:good-crl-https" }, "expect": { "outcome": "refused", "reason": "RevocationStatusUnknown" } },
        { "id": "crl-no-next-update", "title": "CRL without nextUpdate", "tags": ["crl", "faults"],
          "sandbox": { "crl": "NoNextUpdate" },
          "options": { "credentialId": "sandbox:good-crl-https" }, "expect": { "outcome": "refused", "reason": "RevocationStatusUnknown" } },
        { "id": "stale-crl", "title": "Revoked after the CRL a client may have cached", "tags": ["crl", "faults", "revocation"],
          "description": "The CRL served predates the revocation; the OCSP responder already knows it.",
          "sandbox": { "revoke": ["rsa-4096"], "crl": "Stale" },
          "options": { "credentialId": "sandbox:rsa-4096" }, "expect": { "outcome": "refused", "reason": "CertificateRevoked" } },
        { "id": "validate-crl-wrong-key", "kind": "validate", "title": "Validate a B-B signature when the CRL is signed by another key", "tags": ["crl", "faults", "validation"],
          "sandbox": { "crl": "WrongKey" },
          "options": { "fileId": "step:crl-https-good", "settings": { "trust": ["Sandbox"] } }, "expect": { "outcome": "indeterminate", "indication": "INDETERMINATE" } }
      ]
    },
    {
      "id": "ocsp",
      "title": "OCSP responder",
      "description": "Certificates whose only revocation source is OCSP, every failure the responder can be switched to, and the fallback between OCSP and CRL.",
      "steps": [
        { "id": "ocsp-good", "title": "Good, OCSP only", "tags": ["ocsp"],
          "options": { "credentialId": "sandbox:good-ocsp" }, "expect": { "outcome": "signed", "level": "B-B" } },
        { "id": "revoked-ocsp", "title": "Revoked, OCSP only", "tags": ["ocsp", "revocation"],
          "options": { "credentialId": "sandbox:revoked-ocsp" }, "expect": { "outcome": "refused", "reason": "CertificateRevoked" } },
        { "id": "ocsp-blt", "title": "B-LT with the OCSP response embedded", "tags": ["ocsp", "tsa"],
          "options": { "credentialId": "sandbox:good-ocsp", "level": "BLT", "timestamp": { "provider": "Sandbox" } },
          "expect": { "outcome": "signed", "level": "B-LT" } },
        { "id": "validate-ocsp-blt", "kind": "validate", "title": "Validate the B-LT signature with its embedded OCSP response", "tags": ["ocsp", "validation"],
          "options": { "fileId": "step:ocsp-blt", "settings": { "trust": ["Sandbox"] } }, "expect": { "outcome": "valid", "indication": "TOTAL_PASSED" } },
        { "id": "ocsp-down", "title": "Responder down", "tags": ["ocsp", "faults"],
          "sandbox": { "ocsp": "Down" },
          "options": { "credentialId": "sandbox:good-ocsp" }, "expect": { "outcome": "refused", "reason": "RevocationStatusUnknown" } },
        { "id": "ocsp-slow", "title": "Responder slow (3 s)", "tags": ["ocsp", "faults"],
          "sandbox": { "ocsp": "Slow" },
          "options": { "credentialId": "sandbox:good-ocsp" }, "expect": { "outcome": "signed", "level": "B-B" } },
        { "id": "ocsp-try-later", "title": "Responder answers tryLater", "tags": ["ocsp", "faults"],
          "sandbox": { "ocsp": "TryLater" },
          "options": { "credentialId": "sandbox:good-ocsp" }, "expect": { "outcome": "refused", "reason": "RevocationStatusUnknown" } },
        { "id": "ocsp-expired", "title": "Response past its nextUpdate", "tags": ["ocsp", "faults"],
          "sandbox": { "ocsp": "Expired" },
          "options": { "credentialId": "sandbox:good-ocsp" }, "expect": { "outcome": "refused", "reason": "RevocationStatusUnknown" } },
        { "id": "ocsp-unauthorized", "title": "Response signed by an unauthorized responder", "tags": ["ocsp", "faults"],
          "sandbox": { "ocsp": "Unauthorized" },
          "options": { "credentialId": "sandbox:good-ocsp" }, "expect": { "outcome": "refused", "reason": "RevocationStatusUnknown" } },
        { "id": "ocsp-unknown", "title": "Responder answers unknown", "tags": ["ocsp", "faults"],
          "sandbox": { "ocsp": "Unknown" },
          "options": { "credentialId": "sandbox:good-ocsp" }, "expect": { "outcome": "refused", "reason": "RevocationStatusUnknown" } },
        { "id": "fallback-to-crl", "title": "OCSP down, the CRL answers", "tags": ["ocsp", "crl", "fallback"],
          "sandbox": { "ocsp": "Down" },
          "options": { "revocationPreference": "OcspFirst" }, "expect": { "outcome": "signed", "level": "B-B" } },
        { "id": "fallback-to-ocsp", "title": "CRL down, OCSP answers", "tags": ["ocsp", "crl", "fallback"],
          "sandbox": { "crl": "Down" },
          "options": { "revocationPreference": "CrlFirst" }, "expect": { "outcome": "signed", "level": "B-B" } },
        { "id": "fallback-blt", "title": "B-LT with OCSP down: the CRL is embedded", "tags": ["ocsp", "crl", "fallback", "tsa"],
          "sandbox": { "ocsp": "Down" },
          "options": { "level": "BLT", "timestamp": { "provider": "Sandbox" } }, "expect": { "outcome": "signed", "level": "B-LT" } },
        { "id": "both-down", "title": "OCSP and CRL both down", "tags": ["ocsp", "crl", "faults"],
          "sandbox": { "ocsp": "Down", "crl": "Down" },
          "expect": { "outcome": "refused", "reason": "RevocationStatusUnknown" } },
        { "id": "validate-both-down", "kind": "validate", "title": "Validate a B-B signature with OCSP and CRL down", "tags": ["ocsp", "crl", "faults", "validation"],
          "sandbox": { "ocsp": "Down", "crl": "Down" },
          "options": { "fileId": "step:sign-basic", "settings": { "trust": ["Sandbox"] } }, "expect": { "outcome": "indeterminate", "indication": "INDETERMINATE" } }
      ]
    },
    {
      "id": "revocation",
      "title": "Revoked chains and revocations on demand",
      "description": "Certificates the Sandbox issues revoked, and good ones revoked for a single step and put back after it.",
      "steps": [
        { "id": "revoked", "title": "Revoked in the CRL and by OCSP", "tags": ["revocation", "crl", "ocsp"],
          "options": { "credentialId": "sandbox:revoked" }, "expect": { "outcome": "refused", "reason": "CertificateRevoked" } },
        { "id": "revoked-ca", "title": "Under a revoked CA", "tags": ["revocation", "chain"],
          "options": { "credentialId": "sandbox:under-revoked-ca" }, "expect": { "outcome": "refused", "reason": "CertificateRevoked" } },
        { "id": "revoked-cades", "format": "cades", "title": "Revoked, CAdES", "tags": ["revocation", "cades"],
          "options": { "credentialId": "sandbox:revoked" }, "expect": { "outcome": "refused", "reason": "CertificateRevoked" } },
        { "id": "revoked-xades", "format": "xades", "title": "Revoked, XAdES", "tags": ["revocation", "xades"],
          "options": { "credentialId": "sandbox:revoked" }, "expect": { "outcome": "refused", "reason": "CertificateRevoked" } },
        { "id": "revoke-now", "title": "Good certificate revoked for this step", "tags": ["revocation", "on-demand"],
          "sandbox": { "revoke": ["rsa-3072"] },
          "options": { "credentialId": "sandbox:rsa-3072" }, "expect": { "outcome": "refused", "reason": "CertificateRevoked" } },
        { "id": "revoke-put-back", "title": "The same certificate after the step put it back", "tags": ["revocation", "on-demand"],
          "options": { "credentialId": "sandbox:rsa-3072" }, "expect": { "outcome": "signed", "level": "B-B" } },
        { "id": "revoke-now-ocsp", "title": "OCSP-only certificate revoked for this step", "tags": ["revocation", "on-demand", "ocsp"],
          "sandbox": { "revoke": ["good-ocsp"] },
          "options": { "credentialId": "sandbox:good-ocsp" }, "expect": { "outcome": "refused", "reason": "CertificateRevoked" } },
        { "id": "revoke-now-ldap", "title": "LDAP-only certificate revoked for this step", "tags": ["revocation", "on-demand", "crl", "ldap"],
          "sandbox": { "revoke": ["good-crl-ldap"] },
          "options": { "credentialId": "sandbox:good-crl-ldap" }, "expect": { "outcome": "refused", "reason": "CertificateRevoked" } },
        { "id": "poe-file", "title": "B-T signature to revoke later", "tags": ["revocation", "poe", "tsa"],
          "options": { "credentialId": "sandbox:ecdsa-p384", "level": "BT", "timestamp": { "provider": "Sandbox" } },
          "expect": { "outcome": "signed", "level": "B-T" } },
        { "id": "revoked-after-poe", "kind": "validate", "title": "Revoked after its time-stamp: still valid", "tags": ["revocation", "poe", "validation"],
          "wait": 2,
          "sandbox": { "revoke": ["ecdsa-p384"] },
          "options": { "fileId": "step:poe-file", "settings": { "trust": ["Sandbox"] } },
          "expect": { "outcome": "valid", "indication": "TOTAL_PASSED" } }
      ]
    },
    {
      "id": "validity",
      "title": "Validity, key usage and algorithms",
      "steps": [
        { "id": "expired", "title": "Expired certificate", "tags": ["validity"],
          "options": { "credentialId": "sandbox:expired" }, "expect": { "outcome": "refused", "reason": "CertificateExpired" } },
        { "id": "not-yet-valid", "title": "Not yet valid", "tags": ["validity"],
          "options": { "credentialId": "sandbox:not-yet-valid" }, "expect": { "outcome": "refused", "reason": "CertificateNotCurrentlyValid" } },
        { "id": "expired-ca", "title": "Under an expired CA", "tags": ["validity", "chain"],
          "options": { "credentialId": "sandbox:under-expired-ca" }, "expect": { "outcome": "refused", "reason": "ChainCertificateNotValid" } },
        { "id": "sha1-ca", "title": "Under a CA signed with SHA-1", "tags": ["algorithms", "chain"],
          "description": "The IOFE policy refuses SHA-1 in the CA certificates (CACertificate/Cryptographic).",
          "options": { "credentialId": "sandbox:under-sha1-ca", "signingPolicyId": "preset:signing:iofe" },
          "expect": { "outcome": "refused", "reason": "AlgorithmNotPermitted" } },
        { "id": "weak-key", "title": "RSA 1024", "tags": ["algorithms"],
          "options": { "credentialId": "sandbox:rsa-1024" }, "expect": { "outcome": "refused", "reason": "KeyTooWeak" } },
        { "id": "no-signing-key-usage", "title": "Key usage keyEncipherment only", "tags": ["key-usage"],
          "options": { "credentialId": "sandbox:no-signing-key-usage" }, "expect": { "outcome": "refused", "reason": "KeyUsageNotPermitted" } },
        { "id": "no-key-usage-extension", "title": "No key usage extension", "tags": ["key-usage"],
          "options": { "credentialId": "sandbox:no-key-usage-extension" }, "expect": { "outcome": "refused", "reason": "KeyUsageNotPermitted" } },
        { "id": "no-nonrepudiation", "title": "digitalSignature without nonRepudiation", "tags": ["key-usage"],
          "options": { "credentialId": "sandbox:no-nonrepudiation" }, "expect": { "outcome": "signed", "level": "B-B" } }
      ]
    },
    {
      "id": "short-lived",
      "title": "Short-lived certificates",
      "description": "Signers issued when the step runs, valid for 20 seconds: a B-LTA signature outlives its certificate, a B-B one does not.",
      "steps": [
        { "id": "short-lived-blta", "title": "B-LTA with a 20-second certificate", "tags": ["short-lived", "poe", "tsa"],
          "options": { "credentialId": "sandbox-short-lived:20", "level": "BLTA", "timestamp": { "provider": "Sandbox" } },
          "expect": { "outcome": "signed", "level": "B-LTA" } },
        { "id": "short-lived-bb", "title": "B-B with a 20-second certificate", "tags": ["short-lived"],
          "options": { "credentialId": "sandbox-short-lived:20" },
          "expect": { "outcome": "signed", "level": "B-B" } },
        { "id": "short-lived-blta-valid", "kind": "validate", "title": "The B-LTA signature after its certificate expired", "tags": ["short-lived", "poe", "validation"],
          "wait": 25,
          "options": { "fileId": "step:short-lived-blta", "settings": { "trust": ["Sandbox"] } },
          "expect": { "outcome": "valid", "indication": "TOTAL_PASSED" } },
        { "id": "short-lived-bb-expired", "kind": "validate", "title": "The B-B signature after its certificate expired", "tags": ["short-lived", "validation"],
          "options": { "fileId": "step:short-lived-bb", "settings": { "trust": ["Sandbox"] } },
          "expect": { "outcome": "indeterminate", "indication": "INDETERMINATE", "subIndication": "OUT_OF_BOUNDS_NO_POE" } }
      ]
    },
    {
      "id": "trust",
      "title": "Trust anchors and the trusted list",
      "description": "The Sandbox's root, its trusted list (/tl/tl.xml) and every failure the list can be switched to, before signing and when validating.",
      "steps": [
        { "id": "trust-root", "title": "Chain to the Sandbox root", "tags": ["trust"],
          "options": { "signingControls": { "trust": ["SandboxRoot"] } }, "expect": { "outcome": "signed", "level": "B-B" } },
        { "id": "trust-list", "title": "Chain to the trusted list", "tags": ["trust", "trusted-list"],
          "options": { "signingControls": { "trust": ["SandboxTrustedList"] } }, "expect": { "outcome": "signed", "level": "B-B" } },
        { "id": "validate-trust-list", "kind": "validate", "title": "Validate with the trusted list as anchors", "tags": ["trust", "trusted-list", "validation"],
          "options": { "fileId": "step:trust-list", "settings": { "trust": ["SandboxTrustedList"] } }, "expect": { "outcome": "valid" } },
        { "id": "trust-list-expired", "title": "Trusted list past its NextUpdate", "tags": ["trust", "trusted-list", "faults"],
          "sandbox": { "trustedList": "Expired" },
          "options": { "signingControls": { "trust": ["SandboxTrustedList"] } }, "expect": { "outcome": "refused", "reason": "UntrustedRoot" } },
        { "id": "trust-list-wrong-signer", "title": "Trusted list signed by another operator", "tags": ["trust", "trusted-list", "faults"],
          "sandbox": { "trustedList": "WrongSigner" },
          "options": { "signingControls": { "trust": ["SandboxTrustedList"] } }, "expect": { "outcome": "refused", "reason": "UntrustedRoot" } },
        { "id": "trust-list-tampered", "title": "Trusted list changed after it was signed", "tags": ["trust", "trusted-list", "faults"],
          "sandbox": { "trustedList": "Tampered" },
          "options": { "signingControls": { "trust": ["SandboxTrustedList"] } }, "expect": { "outcome": "refused", "reason": "UntrustedRoot" } },
        { "id": "validate-trust-list-wrong-signer", "kind": "validate", "title": "Validate when the trusted list has another signer", "tags": ["trust", "trusted-list", "faults", "validation"],
          "sandbox": { "trustedList": "WrongSigner" },
          "options": { "fileId": "step:trust-list", "settings": { "trust": ["SandboxTrustedList"] } }, "expect": { "outcome": "indeterminate" } },
        { "id": "trust-list-history", "title": "B-T signature trusted through the list", "tags": ["trust", "trusted-list", "poe", "tsa"],
          "options": { "level": "BT", "timestamp": { "provider": "Sandbox" }, "signingControls": { "trust": ["SandboxTrustedList"] } },
          "expect": { "outcome": "signed", "level": "B-T" } },
        { "id": "trust-list-withdrawn", "title": "Root withdrawn from the list: a new signature is refused", "tags": ["trust", "trusted-list", "faults"],
          "sandbox": { "trustedList": "WithdrawnAfterUse" },
          "options": { "signingControls": { "trust": ["SandboxTrustedList"] } },
          "expect": { "outcome": "refused", "reason": "UntrustedRoot" } },
        { "id": "validate-trust-list-withdrawn", "kind": "validate", "title": "Root withdrawn after the time-stamp: still valid", "tags": ["trust", "trusted-list", "poe", "validation"],
          "wait": 2,
          "sandbox": { "trustedList": "WithdrawnAfterUse" },
          "options": { "fileId": "step:trust-list-history", "settings": { "trust": ["SandboxTrustedList"] } },
          "expect": { "outcome": "valid", "indication": "TOTAL_PASSED" } },
        { "id": "iofe-profile", "title": "IOFE profile read from the Sandbox's list", "tags": ["trust", "trusted-list", "iofe"],
          "options": { "signingControls": { "trust": [], "profile": "Iofe", "profileSource": "Sandbox" } },
          "expect": { "outcome": "signed", "level": "B-B" } },
        { "id": "validate-iofe-profile", "kind": "validate", "title": "Validate with the IOFE profile and policy", "tags": ["trust", "trusted-list", "iofe", "validation"],
          "options": { "fileId": "step:iofe-profile", "settings": { "trust": [], "policyId": "preset:validation:iofe", "profile": "Iofe", "profileSource": "Sandbox" } },
          "expect": { "outcome": "valid" } }
      ]
    },
    {
      "id": "validation-samples",
      "title": "Validation of the Sandbox samples",
      "description": "The signed samples made with the Sandbox's certificates: what a validator must accept and what it must not.",
      "steps": [
        { "id": "sample-valid", "kind": "validate", "title": "Valid", "tags": ["validation"],
          "options": { "fileId": "sample:valid", "settings": { "trust": ["Sandbox"] } },
          "expect": { "outcome": "valid", "indication": "TOTAL_PASSED", "etsiReport": "valid" } },
        { "id": "sample-revoked", "kind": "validate", "title": "Revoked signer", "tags": ["validation", "revocation"],
          "options": { "fileId": "sample:revoked", "settings": { "trust": ["Sandbox"] } },
          "expect": { "outcome": "indeterminate", "indication": "INDETERMINATE", "subIndication": "REVOKED_NO_POE" } },
        { "id": "sample-expired", "kind": "validate", "title": "Expired signer", "tags": ["validation", "validity"],
          "options": { "fileId": "sample:expired", "settings": { "trust": ["Sandbox"] } },
          "expect": { "outcome": "indeterminate", "indication": "INDETERMINATE", "subIndication": "OUT_OF_BOUNDS_NO_POE" } },
        { "id": "sample-untrusted-root", "kind": "validate", "title": "Root outside the trust anchors", "tags": ["validation", "trust"],
          "options": { "fileId": "sample:untrusted-root", "settings": { "trust": ["Sandbox"] } },
          "expect": { "outcome": "indeterminate", "indication": "INDETERMINATE", "subIndication": "NO_CERTIFICATE_CHAIN_FOUND" } },
        { "id": "sample-tampered", "kind": "validate", "title": "Content changed after signing", "tags": ["validation"],
          "options": { "fileId": "sample:tampered-content", "settings": { "trust": ["Sandbox"] } },
          "expect": { "outcome": "invalid", "indication": "TOTAL_FAILED" } },
        { "id": "sample-cades-changed", "kind": "validate", "title": "CAdES: data changed", "tags": ["validation", "cades"],
          "options": { "fileId": "cades-sample:v-changed-data", "dataId": "cades-sample:v-changed-data#data", "settings": { "trust": ["Sandbox"] } },
          "expect": { "outcome": "invalid", "indication": "TOTAL_FAILED", "subIndication": "HASH_FAILURE" } },
        { "id": "sample-xades-changed", "kind": "validate", "title": "XAdES: data changed", "tags": ["validation", "xades"],
          "options": { "fileId": "xades-sample:v-changed", "settings": { "trust": ["Sandbox"] } },
          "expect": { "outcome": "invalid", "indication": "TOTAL_FAILED", "subIndication": "HASH_FAILURE" } }
      ]
    }
  ]
}
