<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SimpleSign.Desktop.ViewModels"
             xmlns:s="using:SimpleSign.Desktop.Services"
             xmlns:c="using:SimpleSign.Desktop.Controls"
             xmlns:v="using:SimpleSign.Desktop.Views"
             x:Class="SimpleSign.Desktop.Views.ValidateView"
             x:DataType="vm:ValidateViewModel">
  <StackPanel Spacing="16">
    <c:PageChrome />
    <c:DropZone FileName="{Binding FileName}" Hint="PDF, .p7s, .p7m ou XML assinado · ou clique para escolher" />

    <Border Classes="card" IsVisible="{Binding NeedsData}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Escolher arquivo assinado…" Command="{Binding PickDataCommand}" />
        <StackPanel Spacing="2">
          <TextBlock Classes="title" Text="Assinatura destacada (.p7s)" />
          <TextBlock Classes="caption" Text="{Binding DataFileName, FallbackValue='Escolha o arquivo que foi assinado.', TargetNullValue='Escolha o arquivo que foi assinado.'}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <TextBlock Classes="title" Text="{Binding Summary}" IsVisible="{Binding Summary, Converter={x:Static v:Converters.NotNull}}" />

    <ItemsControl ItemsSource="{Binding Reports}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate><StackPanel Spacing="14" /></ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="s:SignatureReport">
          <Border Classes="card">
            <StackPanel Spacing="14">
              <DockPanel>
                <Border DockPanel.Dock="Right" Classes="badge" VerticalAlignment="Top"
                        Classes.ok="{Binding Verdict, Converter={x:Static v:Converters.IsOk}}"
                        Classes.warn="{Binding Verdict, Converter={x:Static v:Converters.IsWarning}}"
                        Classes.error="{Binding Verdict, Converter={x:Static v:Converters.IsFailed}}">
                  <TextBlock Text="{Binding VerdictText}" />
                </Border>
                <StackPanel Spacing="2">
                  <TextBlock Classes="title" Text="{Binding Signer, TargetNullValue='Signatário desconhecido'}" />
                  <TextBlock Classes="caption"><Run Text="{Binding Title}" /><Run Text=" · " /><Run Text="{Binding SigningTime}" /></TextBlock>
                </StackPanel>
              </DockPanel>
              <ItemsControl ItemsSource="{Binding Checks}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="s:CheckItem">
                    <StackPanel Orientation="Horizontal" Spacing="8" Width="300" Margin="0,4">
                      <Path Classes="icon" Width="15" Height="15"
                            Stroke="{Binding State, Converter={x:Static v:Converters.StateBrush}}"
                            Data="{Binding State, Converter={x:Static v:Converters.StateIcon}}" />
                      <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                      <TextBlock Classes="caption" Text="{Binding Detail}" VerticalAlignment="Center" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Border Classes="group" IsVisible="{Binding Details.Count, Converter={x:Static v:Converters.Any}}">
                <ItemsControl ItemsSource="{Binding Details}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="s:DetailItem">
                      <Grid ColumnDefinitions="190,*" Margin="0,2">
                        <TextBlock Classes="caption" Text="{Binding Key}" />
                        <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
              <ItemsControl ItemsSource="{Binding Errors}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <SelectableTextBlock Text="{Binding}" Foreground="{DynamicResource App.Danger}" TextWrapping="Wrap" Margin="0,2" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Expander Header="Avisos" IsVisible="{Binding Warnings.Count, Converter={x:Static v:Converters.Any}}">
                <ItemsControl ItemsSource="{Binding Warnings}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <SelectableTextBlock Text="{Binding}" Classes="caption" TextWrapping="Wrap" Margin="0,2" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Expander>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
