{
  "$schema": "https://raw.githubusercontent.com/eupassarin/SimpleSign/main/docs/schemas/playbook.schema.json",
  "schema": 2,
  "id": "govbr-pades",
  "title": "Gov.br PAdES (validation)",
  "description": "Gov.br signatures (advanced electronic signatures, Lei 14.063/2020) are made on Gov.br's own portal, as PAdES; SimpleSign does not make them, it validates them (the gov-br profile has no signing policy). This playbook validates PAdES files with the gov-br trust profile (the Gov.br AC roots bundled with SimpleSign.Brazil.GovBr and its chain validation) and its validation policy (the default's constraints, and a signing certificate without digitalSignature or nonRepudiation fails), through the library and the CLI. The signed files stand in for the portal's: the Sandbox signs them and its trust is added to the profile's (trustProfiles: Sandbox), so the checks show without a real Gov.br account; the first section shows that the profile alone trusts only the Gov.br chain. The last section raises the level of such a signature (B-LT, B-LTA), as a relying party that keeps it does.",
  "defaults": {
    "engine": "both",
    "format": "pades",
    "options": {
      "common": {
        "level": "BB",
        "credentialId": "sandbox:rsa-2048",
        "attemptRefused": true,
        "validation": { "trust": [], "profile": "GovBr", "trustProfiles": ["Sandbox"], "policyId": "preset:validation:govbr" }
      },
      "pades": { "documentId": "sample:contract" }
    }
  },
  "inputs": [
    { "id": "govbr-signed", "title": "A PDF signed on Gov.br's portal", "accept": ".pdf",
      "description": "Sign any PDF at the Gov.br signing service and upload what it hands back. The steps of the section 'A signature from the portal' validate it with the gov-br profile alone (the real Gov.br chain, no Sandbox), raise its level and add a second signer; without the file they are skipped." }
  ],
  "sections": [
    {
      "id": "files",
      "title": "Files to validate",
      "description": "PAdES signatures like the portal hands back: one or more signers of a PDF, with or without a visible stamp. Each one is validated right after with the gov-br profile and the Sandbox's trust.",
      "steps": [
        { "id": "signed-etsi", "title": "PAdES B-B, ETSI.CAdES.detached", "tags": ["gov.br", "Lei 14.063", "files"],
          "options": { "subFilter": "EtsiCadesDetached" },
          "expect": { "outcome": "signed", "level": "B-B", "indication": "TOTAL_PASSED" } },
        { "id": "signed-pkcs7", "title": "PAdES B-B, adbe.pkcs7.detached", "tags": ["gov.br", "files"],
          "options": { "subFilter": "AdbePkcs7Detached" },
          "expect": { "outcome": "signed", "indication": "TOTAL_PASSED" } },
        { "id": "signed-visible", "title": "With a visible stamp", "tags": ["gov.br", "files", "appearance"],
          "options": { "appearance": { "visible": true, "autoPosition": true, "showDate": true, "culture": "pt-BR",
            "timeZoneId": "America/Sao_Paulo", "dateFormat": "dd/MM/yyyy HH:mm", "signedByLabel": "Documento assinado digitalmente por",
            "verificationUrl": "https://validar.iti.gov.br" } },
          "expect": { "outcome": "signed", "indication": "TOTAL_PASSED" } },
        { "id": "signed-second", "title": "A second signer of the same PDF", "tags": ["gov.br", "files"],
          "options": { "documentId": "step:signed-etsi", "credentialId": "sandbox:rsa-3072", "fieldName": "Assinatura2" },
          "expect": { "outcome": "signed", "indication": "TOTAL_PASSED" } },
        { "id": "key-usage-file", "title": "Signer with neither digitalSignature nor nonRepudiation (minimal signing policy, to validate)", "tags": ["key-usage"],
          "options": { "credentialId": "sandbox:no-signing-key-usage", "signingPolicyId": "preset:signing:minimal", "validate": false },
          "expect": { "outcome": "signed" } }
      ]
    },
    {
      "id": "trust",
      "title": "The Gov.br profile",
      "description": "Its anchors are the Gov.br AC Raiz and intermediates; a chain that does not reach them is not trusted.",
      "steps": [
        { "id": "v-profile-only", "kind": "validate", "title": "Profile alone: the Sandbox's chain is not Gov.br's", "tags": ["gov.br", "trust"],
          "options": { "fileId": "step:signed-etsi", "settings": { "trust": [], "profile": "GovBr", "trustProfiles": [], "policyId": "preset:validation:govbr" } },
          "expect": { "outcome": "indeterminate", "indication": "INDETERMINATE", "subIndication": "NO_CERTIFICATE_CHAIN_FOUND" } },
        { "id": "v-with-sandbox", "kind": "validate", "title": "Profile with the Sandbox's trust added", "tags": ["gov.br", "trust"],
          "options": { "fileId": "step:signed-etsi", "settings": { "trust": [], "profile": "GovBr", "trustProfiles": ["Sandbox"], "policyId": "preset:validation:govbr" } },
          "expect": { "outcome": "valid", "indication": "TOTAL_PASSED", "etsiReport": "valid" } },
        { "id": "v-with-icp", "kind": "validate", "title": "ICP-Brasil's policy, trusting ICP-Brasil, Gov.br and the Sandbox", "tags": ["gov.br", "icp-brasil", "trust"],
          "description": "A relying party that accepts both Brazilian signatures: one profile sets the policy, the others add their trust.",
          "options": { "fileId": "step:signed-etsi", "settings": { "trust": [], "profile": "IcpBrasil", "trustProfiles": ["GovBr", "Sandbox"], "policyId": "preset:validation:icp-brasil" } },
          "expect": { "outcome": "valid", "indication": "TOTAL_PASSED" } }
      ]
    },
    {
      "id": "validation",
      "title": "Validation with the Gov.br policy",
      "steps": [
        { "id": "v-pkcs7", "kind": "validate", "title": "adbe.pkcs7.detached", "tags": ["gov.br", "validation"],
          "options": { "fileId": "step:signed-pkcs7", "settings": { "trust": [], "profile": "GovBr", "trustProfiles": ["Sandbox"], "policyId": "preset:validation:govbr" } }, "expect": { "outcome": "valid", "indication": "TOTAL_PASSED" } },
        { "id": "v-visible", "kind": "validate", "title": "Visible stamp", "tags": ["gov.br", "validation", "appearance"],
          "options": { "fileId": "step:signed-visible", "settings": { "trust": [], "profile": "GovBr", "trustProfiles": ["Sandbox"], "policyId": "preset:validation:govbr" } }, "expect": { "outcome": "valid", "indication": "TOTAL_PASSED" } },
        { "id": "v-two-signers", "kind": "validate", "title": "Two signers", "tags": ["gov.br", "validation"],
          "options": { "fileId": "step:signed-second", "settings": { "trust": [], "profile": "GovBr", "trustProfiles": ["Sandbox"], "policyId": "preset:validation:govbr" } }, "expect": { "outcome": "valid", "indication": "TOTAL_PASSED" } },
        { "id": "v-appended", "kind": "validate", "title": "Bytes appended after the signature", "tags": ["gov.br", "validation", "integrity"],
          "description": "The signed revision is intact; the report says the ByteRange does not cover the whole file.",
          "options": { "fileId": "sample:appended", "settings": { "trust": [], "profile": "GovBr", "trustProfiles": ["Sandbox"], "policyId": "preset:validation:govbr" } }, "expect": { "outcome": "valid" } },
        { "id": "v-tampered", "kind": "validate", "title": "Document changed after signing", "tags": ["gov.br", "validation", "integrity"],
          "options": { "fileId": "sample:tampered-content", "settings": { "trust": [], "profile": "GovBr", "trustProfiles": ["Sandbox"], "policyId": "preset:validation:govbr" } }, "expect": { "outcome": "invalid", "indication": "TOTAL_FAILED", "subIndication": "HASH_FAILURE" } },
        { "id": "v-tampered-cms", "kind": "validate", "title": "Signature value changed", "tags": ["gov.br", "validation", "integrity"],
          "options": { "fileId": "sample:tampered-cms", "settings": { "trust": [], "profile": "GovBr", "trustProfiles": ["Sandbox"], "policyId": "preset:validation:govbr" } }, "expect": { "outcome": "invalid", "indication": "TOTAL_FAILED", "subIndication": "SIG_CRYPTO_FAILURE" } },
        { "id": "v-revoked", "kind": "validate", "title": "Signer revoked, no proof of existence before it", "tags": ["gov.br", "validation", "revocation"],
          "options": { "fileId": "sample:revoked", "settings": { "trust": [], "profile": "GovBr", "trustProfiles": ["Sandbox"], "policyId": "preset:validation:govbr" } }, "expect": { "outcome": "indeterminate", "indication": "INDETERMINATE", "subIndication": "REVOKED_NO_POE" } },
        { "id": "v-revocation-unknown", "kind": "validate", "title": "Revocation status unknown (OCSP and CRL down)", "tags": ["gov.br", "validation", "revocation"],
          "sandbox": { "ocsp": "Down", "crl": "Down" },
          "options": { "fileId": "step:signed-etsi", "settings": { "trust": [], "profile": "GovBr", "trustProfiles": ["Sandbox"], "policyId": "preset:validation:govbr" } }, "expect": { "outcome": "indeterminate", "indication": "INDETERMINATE" } },
        { "id": "v-expired", "kind": "validate", "title": "Signer expired, no proof of existence", "tags": ["gov.br", "validation", "validity"],
          "options": { "fileId": "sample:expired", "settings": { "trust": [], "profile": "GovBr", "trustProfiles": ["Sandbox"], "policyId": "preset:validation:govbr" } }, "expect": { "outcome": "indeterminate", "indication": "INDETERMINATE", "subIndication": "OUT_OF_BOUNDS_NO_POE" } },
        { "id": "v-untrusted", "kind": "validate", "title": "Self-signed signer", "tags": ["gov.br", "validation", "trust"],
          "options": { "fileId": "sample:untrusted-root", "settings": { "trust": [], "profile": "GovBr", "trustProfiles": ["Sandbox"], "policyId": "preset:validation:govbr" } }, "expect": { "outcome": "indeterminate", "indication": "INDETERMINATE", "subIndication": "NO_CERTIFICATE_CHAIN_FOUND" } },
        { "id": "v-key-usage", "kind": "validate", "title": "Signer with neither digitalSignature nor nonRepudiation: not accepted", "tags": ["gov.br", "validation", "key-usage"],
          "description": "The constraint the Gov.br policy adds to the default one.",
          "options": { "fileId": "step:key-usage-file", "settings": { "trust": [], "profile": "GovBr", "trustProfiles": ["Sandbox"], "policyId": "preset:validation:govbr" } }, "expect": { "outcome": "indeterminate", "indication": "INDETERMINATE" } }
      ]
    },
    {
      "id": "preservation",
      "title": "Keeping a Gov.br signature",
      "description": "The portal hands back a B-B signature: no time-stamp proves when it was made. The relying party raises its level (a document time-stamp and the validation data: B-LT, then B-LTA), so the signature can still be validated after the signer's certificate expires (EN 319 142-1 accepts a document time-stamp for level T).",
      "steps": [
        { "id": "aug-blt", "kind": "augment", "title": "Raised to B-LT", "tags": ["gov.br", "preservation", "augment"], "engine": "library",
          "options": { "fileId": "step:signed-etsi", "level": "BLT", "timestamp": { "provider": "Sandbox" } },
          "expect": { "outcome": "augmented", "level": "B-LT", "indication": "TOTAL_PASSED" } },
        { "id": "aug-blta", "kind": "augment", "title": "Raised to B-LTA", "tags": ["gov.br", "preservation", "augment"], "engine": "library",
          "options": { "fileId": "step:aug-blt", "level": "BLTA", "timestamp": { "provider": "Sandbox" } },
          "expect": { "outcome": "augmented", "level": "B-LTA", "indication": "TOTAL_PASSED" } },
        { "id": "v-archival", "kind": "validate", "title": "Validated at the archival level", "tags": ["gov.br", "preservation", "validation"],
          "options": { "fileId": "step:aug-blta", "settings": { "trust": [], "profile": "GovBr", "trustProfiles": ["Sandbox"], "policyId": "preset:validation:govbr", "level": "ArchivalData" } }, "expect": { "outcome": "valid", "indication": "TOTAL_PASSED" } },
        { "id": "short-lived", "title": "Signed by a certificate valid for 20 seconds", "tags": ["gov.br", "preservation"], "engine": "library",
          "options": { "credentialId": "sandbox-short-lived:20" }, "expect": { "outcome": "signed", "level": "B-B" } },
        { "id": "short-lived-blta", "kind": "augment", "title": "Raised to B-LTA at once", "tags": ["gov.br", "preservation", "augment"], "engine": "library",
          "options": { "fileId": "step:short-lived", "level": "BLTA", "timestamp": { "provider": "Sandbox" } },
          "expect": { "outcome": "augmented", "level": "B-LTA", "indication": "TOTAL_PASSED" } },
        { "id": "v-after-expiry", "kind": "validate", "title": "Validated after the signer's certificate expired", "tags": ["gov.br", "preservation", "validation"],
          "description": "The document time-stamp the augmentation added proves the signature existed while the certificate was valid.",
          "wait": 25,
          "options": { "fileId": "step:short-lived-blta", "settings": { "trust": [], "profile": "GovBr", "trustProfiles": ["Sandbox"], "policyId": "preset:validation:govbr", "level": "ArchivalData" } }, "expect": { "outcome": "valid", "indication": "TOTAL_PASSED" } },
        { "id": "v-expired-not-raised", "kind": "validate", "title": "The same signature not raised: no proof of existence", "tags": ["gov.br", "preservation", "validation"],
          "options": { "fileId": "step:short-lived", "settings": { "trust": [], "profile": "GovBr", "trustProfiles": ["Sandbox"], "policyId": "preset:validation:govbr" } },
          "expect": { "outcome": "indeterminate", "indication": "INDETERMINATE", "subIndication": "OUT_OF_BOUNDS_NO_POE" } }
      ]
    },
    {
      "id": "portal",
      "title": "A signature from the portal",
      "description": "The file uploaded for input:govbr-signed, made by Gov.br itself: its chain goes to the Gov.br AC Raiz bundled with SimpleSign.Brazil.GovBr, so only the profile's trust is used.",
      "steps": [
        { "id": "v-portal", "kind": "validate", "title": "Validate the portal's signature with the Gov.br profile alone", "tags": ["gov.br", "Lei 14.063", "portal", "validation"],
          "description": "An intact signature made on the portal, by a certificate that is valid and not revoked, is accepted under the gov-br profile and policy (without a signing-certificate attribute, which the portal does not write, the policy only warns).",
          "options": { "fileId": "input:govbr-signed", "settings": { "trust": [], "profile": "GovBr", "trustProfiles": [], "policyId": "preset:validation:govbr" } }, "expect": { "outcome": "valid", "indication": "TOTAL_PASSED" } },
        { "id": "v-portal-icp-trust", "kind": "validate", "title": "Validate it with the Gov.br policy, also trusting ICP-Brasil", "tags": ["gov.br", "icp-brasil", "portal", "validation"],
          "description": "A relying party that accepts both Brazilian signatures: Gov.br's profile sets the policy (a missing signing-certificate attribute only warns), ICP-Brasil's adds its trust.",
          "options": { "fileId": "input:govbr-signed", "settings": { "trust": [], "profile": "GovBr", "trustProfiles": ["IcpBrasil"], "policyId": "preset:validation:govbr" } },
          "expect": { "outcome": "valid", "indication": "TOTAL_PASSED" } },
        { "id": "v-portal-icp-policy", "kind": "validate", "title": "Under the ICP-Brasil policy: no signing-certificate attribute", "tags": ["gov.br", "icp-brasil", "portal", "validation"],
          "description": "The portal signs in adbe.pkcs7.detached without the ESS signing-certificate-v2 attribute, which the ICP-Brasil policy requires (as the ICP-Brasil signature policies do): under it the signer is not identified.",
          "options": { "fileId": "input:govbr-signed", "settings": { "trust": [], "profile": "IcpBrasil", "trustProfiles": ["GovBr"], "policyId": "preset:validation:icp-brasil" } },
          "expect": { "outcome": "indeterminate", "indication": "INDETERMINATE", "subIndication": "NO_SIGNING_CERTIFICATE_FOUND" } },
        { "id": "portal-blta", "kind": "augment", "title": "Raise the portal's signature to B-LTA", "tags": ["gov.br", "portal", "preservation", "augment"], "engine": "library",
          "options": { "fileId": "input:govbr-signed", "level": "BLTA", "timestamp": { "provider": "Sandbox" }, "validation": { "trust": [], "profile": "GovBr", "trustProfiles": [], "policyId": "preset:validation:govbr" } },
          "expect": { "outcome": "augmented", "level": "B-LTA" } },
        { "id": "portal-second-signer", "title": "Add a second signer to the portal's PDF", "tags": ["gov.br", "portal", "files"],
          "description": "An incremental update after the portal's signature: the PDF keeps it intact and gains a signature made here.",
          "options": { "documentId": "input:govbr-signed", "fieldName": "Assinatura2", "validate": false },
          "expect": { "outcome": "signed" } }
      ]
    }
  ]
}
