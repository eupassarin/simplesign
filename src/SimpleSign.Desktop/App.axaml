<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SimpleSign.Desktop.ViewModels"
             xmlns:views="using:SimpleSign.Desktop.Views"
             x:Class="SimpleSign.Desktop.App"
             Name="SimpleSign"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <FluentTheme>
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Light" Accent="#007AFF" RegionColor="#F5F5F7" />
        <ColorPaletteResources x:Key="Dark" Accent="#0A84FF" RegionColor="#1C1C1E" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://SimpleSign/Styles/AppleTheme.axaml" />
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://SimpleSign/Styles/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.DataTemplates>
    <DataTemplate DataType="vm:SignViewModel"><views:SignView /></DataTemplate>
    <DataTemplate DataType="vm:ValidateViewModel"><views:ValidateView /></DataTemplate>
    <DataTemplate DataType="vm:InspectViewModel"><views:InspectView /></DataTemplate>
    <DataTemplate DataType="vm:TimestampViewModel"><views:TimestampView /></DataTemplate>
    <DataTemplate DataType="vm:TokensViewModel"><views:TokensView /></DataTemplate>
    <DataTemplate DataType="vm:IcpBrasilViewModel"><views:IcpBrasilView /></DataTemplate>
    <DataTemplate DataType="vm:HtmlToPdfViewModel"><views:HtmlToPdfView /></DataTemplate>
    <DataTemplate DataType="vm:AgentViewModel"><views:AgentView /></DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel"><views:SettingsView /></DataTemplate>
  </Application.DataTemplates>

  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon Icon="/Assets/icon.png" ToolTipText="SimpleSign">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Abrir SimpleSign" Click="OnTrayOpen" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Sair" Click="OnTrayQuit" />
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>
</Application>
