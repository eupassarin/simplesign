<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>SimpleSign.XAdES</AssemblyName>
    <RootNamespace>SimpleSign.XAdES</RootNamespace>
    <PackageId>SimpleSign.XAdES</PackageId>
    <Description>Create and validate XAdES digital signatures (ETSI EN 319 132). Supports B-B, B-T, B-LT, and B-LTA conformance levels for XML documents. Uses System.Security.Cryptography and System.Security.Cryptography.Xml.</Description>
    <PackageTags>xades;xml-dsig;xml-signature;digital-signature;electronic-signature;etsi;timestamp</PackageTags>
    <Version>0.7.1</Version>
    <NoWarn>$(NoWarn);CA1508</NoWarn>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SimpleSign.Core\SimpleSign.Core.csproj" />
    <ProjectReference Include="..\SimpleSign.CAdES\SimpleSign.CAdES.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.*" />
  </ItemGroup>

</Project>
