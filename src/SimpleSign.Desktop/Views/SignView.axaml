<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SimpleSign.Desktop.ViewModels"
             xmlns:s="using:SimpleSign.Desktop.Services"
             xmlns:c="using:SimpleSign.Desktop.Controls"
             xmlns:v="using:SimpleSign.Desktop.Views"
             x:Class="SimpleSign.Desktop.Views.SignView"
             x:DataType="vm:SignViewModel">
  <StackPanel Spacing="16">
    <c:PageChrome />

    <c:DropZone FileName="{Binding FileName}" Hint="PDF, XML ou qualquer arquivo · ou clique para escolher" />

    <Border Classes="card">
      <StackPanel Spacing="18">
        <TextBlock Classes="title" Text="Formato" />
        <ListBox Classes="segmented" ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}" HorizontalAlignment="Left">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:OptionBase">
              <TextBlock Text="{Binding Label}" ToolTip.Tip="{Binding Hint}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Grid ColumnDefinitions="*,24,*">
          <StackPanel Spacing="8">
            <TextBlock Classes="title" Text="Política ICP-Brasil" />
            <ComboBox ItemsSource="{Binding Policies}" SelectedItem="{Binding SelectedPolicy}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:OptionBase">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="A versão vigente que aceita a raiz do seu certificado é escolhida automaticamente. Acima de AD-RB usa o carimbo do tempo dos Ajustes." />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="8" IsEnabled="{Binding !UsesPolicy}">
            <TextBlock Classes="title" Text="Nível (sem política)" />
            <ListBox Classes="segmented" ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevel}" HorizontalAlignment="Left">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:OptionBase">
                  <TextBlock Text="{Binding Label}" ToolTip.Tip="{Binding Hint}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Classes="caption" Text="{Binding SelectedLevel.Hint}" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>

    <Border Classes="card">
      <StackPanel Spacing="12">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
            <Button Content="Abrir A1 (PFX)…" Command="{Binding LoadPfxCommand}" />
            <Button Command="{Binding RefreshCertificatesCommand}" ToolTip.Tip="Procurar tokens e certificados">
              <Path Classes="icon" Data="{StaticResource Icon.Refresh}" Width="14" Height="14" />
            </Button>
          </StackPanel>
          <TextBlock Classes="title" Text="Certificado" VerticalAlignment="Center" />
        </DockPanel>
        <ListBox ItemsSource="{Binding Certificates}" SelectedItem="{Binding SelectedCertificate}" MaxHeight="260" Background="Transparent">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="CornerRadius" Value="10" />
              <Setter Property="Padding" Value="12,9" />
              <Setter Property="Margin" Value="0,2" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="s:CertificateEntry">
              <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <Border Classes="badge accent" IsVisible="{Binding IsIcpBrasil}"><TextBlock Text="ICP-Brasil" /></Border>
                  <Border Classes="badge error" IsVisible="{Binding IsExpired}"><TextBlock Text="Expirado" /></Border>
                </StackPanel>
                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding Holder}" FontWeight="SemiBold" />
                  <TextBlock Classes="caption">
                    <Run Text="{Binding Source}" /><Run Text=" · " /><Run Text="{Binding Validity}" /><Run Text=" · " /><Run Text="{Binding Document}" />
                  </TextBlock>
                </StackPanel>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Classes="caption" IsVisible="{Binding !Certificates.Count}"
                   Text="Nenhum certificado encontrado. Abra um arquivo A1 (PFX) ou conecte o token A3 e atualize." />
      </StackPanel>
    </Border>

    <Border Classes="card" IsVisible="{Binding IsPdf}">
      <StackPanel Spacing="12">
        <TextBlock Classes="title" Text="Detalhes da assinatura no PDF" />
        <Grid ColumnDefinitions="*,16,*">
          <TextBox Watermark="Motivo (opcional)" Text="{Binding Reason}" />
          <TextBox Grid.Column="2" Watermark="Local (opcional)" Text="{Binding Location}" />
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <ToggleSwitch IsChecked="{Binding VisibleStamp}" />
          <TextBlock Text="Carimbo visível na página" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </Border>

    <DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10">
        <Button Content="Salvar…" Command="{Binding SaveCommand}" IsVisible="{Binding HasOutput}" />
        <Button Classes="accent" Content="Assinar" Command="{Binding SignCommand}" />
      </StackPanel>
      <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding OutputName}" />
    </DockPanel>
  </StackPanel>
</UserControl>
