<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CA1829;CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.85" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\src\Core\SimpleSign.Core\SimpleSign.Core.csproj" />
    <ProjectReference Include="..\..\..\src\Formats\SimpleSign.PAdES\SimpleSign.PAdES.csproj" />
    <ProjectReference Include="..\..\..\src\Formats\SimpleSign.CAdES\SimpleSign.CAdES.csproj" />
    <ProjectReference Include="..\..\..\src\Formats\SimpleSign.XAdES\SimpleSign.XAdES.csproj" />
    <ProjectReference Include="..\..\shared\SimpleSign.TestHelpers\SimpleSign.TestHelpers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The PDF every PAdES sample signs: the interop tests' (three pages, cross-reference stream, made by qpdf). -->
    <Content Include="..\SimpleSign.Interop.Tests\Fixtures\xref-stream.pdf" Link="Fixtures\xref-stream.pdf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="known-issues.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
