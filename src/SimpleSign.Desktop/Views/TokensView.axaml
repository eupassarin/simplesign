<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SimpleSign.Desktop.ViewModels"
             xmlns:s="using:SimpleSign.Desktop.Services"
             xmlns:c="using:SimpleSign.Desktop.Controls"
             xmlns:v="using:SimpleSign.Desktop.Views"
             x:Class="SimpleSign.Desktop.Views.TokensView"
             x:DataType="vm:TokensViewModel">
  <StackPanel Spacing="16">
    <c:PageChrome />
    <DockPanel>
      <Button DockPanel.Dock="Right" Command="{Binding RefreshCommand}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Path Classes="icon" Data="{StaticResource Icon.Refresh}" Width="14" Height="14" />
          <TextBlock Text="Procurar novamente" />
        </StackPanel>
      </Button>
      <TextBlock Classes="title" Text="Drivers PKCS#11 (tokens A3 e smartcards)" VerticalAlignment="Center" />
    </DockPanel>
    <ItemsControl ItemsSource="{Binding Drivers}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:DriverRow">
          <Border Classes="card" Padding="16">
            <StackPanel Spacing="10">
              <DockPanel>
                <Border DockPanel.Dock="Right" Classes="badge" Classes.ok="{Binding Installed}"><TextBlock Text="{Binding Status}" /></Border>
                <StackPanel Spacing="2">
                  <TextBlock FontWeight="SemiBold"><Run Text="{Binding Vendor}" /><Run Text=" · " /><Run Text="{Binding Product}" /></TextBlock>
                  <TextBlock Classes="caption mono" Text="{Binding Path}" IsVisible="{Binding Installed}" />
                  <TextBlock Classes="caption" Foreground="{DynamicResource App.Danger}" Text="{Binding Error}" IsVisible="{Binding Error, Converter={x:Static v:Converters.NotNull}}" TextWrapping="Wrap" />
                </StackPanel>
              </DockPanel>
              <ItemsControl ItemsSource="{Binding Tokens}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TokenRow">
                    <Border Classes="group" Margin="0,4,0,0">
                      <StackPanel Spacing="6">
                        <TextBlock FontWeight="SemiBold"><Run Text="{Binding Label}" /><Run Text=" — " /><Run Text="{Binding Model}" /></TextBlock>
                        <TextBlock Classes="caption"><Run Text="Série " /><Run Text="{Binding Serial}" /><Run Text=" · " /><Run Text="{Binding Pin}" /></TextBlock>
                        <ItemsControl ItemsSource="{Binding Certificates}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="s:CertificateEntry">
                              <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2">
                                <Path Classes="icon" Data="{StaticResource Icon.Token}" Width="14" Height="14" />
                                <TextBlock Text="{Binding Holder}" />
                                <TextBlock Classes="caption"><Run Text="{Binding Document}" /><Run Text=" · " /><Run Text="{Binding Validity}" /></TextBlock>
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Border Classes="card" IsVisible="{Binding !Drivers.Count}">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Path Classes="icon" Data="{StaticResource Icon.Token}" Width="22" Height="22" />
        <StackPanel Spacing="2">
          <TextBlock Classes="title" Text="Nenhum driver de token instalado" />
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="Instale o software do seu token (ex.: SafeNet Authentication Client, SafeSign) e clique em Procurar novamente." />
        </StackPanel>
      </StackPanel>
    </Border>
    <Expander Header="Drivers conhecidos não instalados" HorizontalAlignment="Stretch">
      <ItemsControl ItemsSource="{Binding MissingDrivers}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:DriverRow">
            <Border Classes="badge" Margin="0,0,8,8"><TextBlock><Run Text="{Binding Vendor}" /><Run Text=" · " /><Run Text="{Binding Product}" /></TextBlock></Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Expander>
    <TextBlock Classes="title" Text="Certificados do sistema" Margin="0,8,0,0" />
    <Border Classes="card">
      <StackPanel>
        <TextBlock Classes="caption" Text="Nenhum certificado com chave privada no repositório do sistema." IsVisible="{Binding !StoreCertificates.Count}" />
        <ItemsControl ItemsSource="{Binding StoreCertificates}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="s:CertificateEntry">
              <StackPanel Spacing="2" Margin="0,6">
                <TextBlock Text="{Binding Holder}" FontWeight="SemiBold" />
                <TextBlock Classes="caption"><Run Text="{Binding Issuer}" /><Run Text=" · " /><Run Text="{Binding Validity}" /></TextBlock>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
